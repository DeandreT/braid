+// Qualification-only native hooks. No web, inspector or command-line API.
+#ifndef BRAID_ISOLATED_CSP_PHASE_PROBE_H_
+#define BRAID_ISOLATED_CSP_PHASE_PROBE_H_
+#include "base/memory/stack_allocated.h"
+#include "base/functional/callback.h"
+#include "third_party/blink/renderer/core/frame/csp/credit_scope.h"
+namespace blink {
+class Event;
+class EventTarget;
+// Stack-bounded, one original event and one receiver. Phase instrumentation
+// calls Check only for the identical native pair. A nested dispatch cannot
+// complete its parent's obligation.
+class CspFixtureAttempt {
+  STACK_ALLOCATED();
+
+ public:
+  using Check = base::RepeatingCallback<bool(const Event&)>;
+  CspFixtureAttempt(const Event& event, const EventTarget& receiver, Check check)
+      : previous_(active_), event_(&event), receiver_(&receiver), check_(std::move(check)) { active_ = this; }
+  ~CspFixtureAttempt() { active_ = previous_; }
+  CspFixtureAttempt(const CspFixtureAttempt&) = delete;
+  CspFixtureAttempt& operator=(const CspFixtureAttempt&) = delete;
+  static void AtPhase(const Event& event, const EventTarget& receiver) {
+    auto* a = active_;
+    if (!a || &event != a->event_ || &receiver != a->receiver_) return;
+    if (a->visited_) { a->matched_ = false; return; }
+    a->visited_ = true;
+    a->matched_ = a->check_.Run(event);
+  }
+  bool matched() const { return matched_; }
+ private:
+  inline static thread_local CspFixtureAttempt* active_ = nullptr;
+  CspFixtureAttempt* const previous_;
+  const Event* const event_;
+  const EventTarget* const receiver_;
+  const Check check_;
+  bool visited_ = false, matched_ = false;
+};
+}  // namespace blink
+#endif
