+TEST_F(WorkerThreadTest, FixtureCspRunsOnOriginalWorkerBeforeGracefulDisposal) {
+  using Ledger = braid::probe::WorkerCspLedger;
+  auto ledger = std::make_shared<Ledger>();
+  auto generation = ledger->Reserve();
+  ASSERT_TRUE(generation);
+  const auto id = generation->id();
+  std::atomic<unsigned> matches{0};
+  const KURL script_url("http://fake.url/");
+  auto params = GlobalScopeCreationParams::CreateForWorkerForTesting(
+      security_origin_.get(), script_url);
+  params->fixture_csp_producer =
+      std::make_unique<FixtureWorkerCspProducer>(FixtureWorkerCspProducer{
+          std::move(generation),
+          base::BindRepeating(
+              [](Ledger::Id id, std::atomic<unsigned>* matches,
+                 Ledger::Id observed, const WorkerToken& token,
+                 const Event& event) {
+                const auto& csp =
+                    static_cast<const SecurityPolicyViolationEvent&>(event);
+                auto* target = event.target();
+                auto* worker = DynamicTo<WorkerGlobalScope>(
+                    target ? target->GetExecutionContext() : nullptr);
+                if (id != observed || !worker || worker != target ||
+                    worker->GetWorkerToken() != token || !event.isTrusted() ||
+                    event.eventPhase() != Event::PhaseType::kAtTarget ||
+                    csp.effectiveDirective() != "connect-src" ||
+                    csp.blockedURI() != "http://fake.url/blocked") {
+                  return false;
+                }
+                ++*matches;
+                return true;
+              },
+              id, base::Unretained(&matches))});
+  ExpectReportingCalls();
+  worker_thread_->Start(std::move(params),
+                        WorkerBackingThreadStartupData::CreateDefault(),
+                        std::make_unique<WorkerDevToolsParams>());
+  RunWorkerToplevelScriptForTesting(*worker_thread_, security_origin_.get(),
+                                    "// CSP fixture worker", script_url);
+  reporting_proxy_->WaitUntilDidEvaluateTopLevelScript();
+
+  // The two closures and the CSP notification share the networking queue.
+  // Enqueue the barrier from the first closure, after CSP has posted.
+  base::WaitableEvent settled;
+  PostCrossThreadTask(
+      *worker_thread_->GetTaskRunner(TaskType::kNetworking), FROM_HERE,
+      CrossThreadBindOnce(
+          [](WorkerThread* thread, base::WaitableEvent* settled) {
+            QueueFixtureCspViolation(
+                *To<WorkerGlobalScope>(thread->GlobalScope()));
+            thread->GetTaskRunner(TaskType::kNetworking)
+                ->PostTask(FROM_HERE,
+                           base::BindOnce(&base::WaitableEvent::Signal,
+                                          base::Unretained(settled)));
+          },
+          CrossThreadUnretained(worker_thread_.get()),
+          CrossThreadUnretained(&settled)));
+  settled.Wait();
+  EXPECT_EQ(1u, matches.load());
+  worker_thread_->Terminate();
+  worker_thread_->WaitForShutdownForTesting();
+  EXPECT_EQ(ExitCode::kGracefullyTerminated, GetExitCode());
+  EXPECT_EQ(Ledger::Refusal::kNone, ledger->SealAndCheckTerminal());
+}
