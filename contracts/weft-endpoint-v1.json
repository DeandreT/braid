{
  "openapi": "3.1.1",
  "info": {
    "title": "Weft mapping endpoint",
    "description": "The machine-facing HTTP host of one registered release target: machine callers send mapping inputs and receive the outputs of the target's current release. There is no browser session, cookie, redirect or default authentication scheme. Every answer carries `Cache-Control: no-store` and `X-Content-Type-Options: nosniff`. Any other path, any query string and any path base answer `404`; another method on a mapped path answers `405` with `Allow`.",
    "version": "v1"
  },
  "paths": {
    "/v1/invocations": {
      "post": {
        "tags": [
          "Invocations"
        ],
        "summary": "Invoke the target's current release.",
        "description": "Runs every target of the current release's qualified artifact with the server's current UTC clock, as the release's publisher. The endpoint admits at most its configured concurrency (1 to 4) without a queue, and a saturated or stopping endpoint answers `503` before it validates the token or reads the body. A call has a 90-second deadline that covers validation, the body, the ledger, one execution and the response; the token's expiry also bounds it. The ledger claims each request ID once, so a retry with the same ID and body returns the recorded outcome instead of running again.",
        "operationId": "InvokeRelease",
        "parameters": [
          {
            "name": "Weft-Request-Id",
            "in": "header",
            "description": "A caller-chosen canonical lowercase UUID, not the nil UUID, sent once. Retrying with the same ID and body returns the original outcome; another body or client application under it conflicts.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "At most 2097152 bytes as `application/json` (optionally `; charset=utf-8`) without a content encoding. Inputs total at most 1 MiB, outputs at most 1 MiB, and the preview bounds on counts, names and parameters apply. Legacy bodies omit schema and media. Document bodies require weft.document-invocation-request.v1 and a mediaType per input matching the qualified boundary; no filename inference. CSV/TSV requires matching csvDialect metadata and a primary-only CSV build. An explicit empty base64 string is a valid empty CSV document; missing content is not. JSON/EDI inputs remain nonempty.",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/MappingInvocationRequestV1"
                  },
                  {
                    "$ref": "#/components/schemas/MappingDocumentInvocationRequestV1"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Completed. A retry with the same request ID and body returns these exact bytes.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "required": true,
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Weft-Invocation-Replayed": {
                "description": "Whether this answer replays an outcome recorded by an earlier call.",
                "required": true,
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationResponseV1"
                    },
                    {
                      "$ref": "#/components/schemas/MappingDocumentInvocationResponseV1"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "A malformed request ID (`invalidRequestId`, without `requestId`) or body (`invalidRequest`). Nothing is recorded.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "invalidRequestId",
                        "invalidRequest"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "A missing, refused or expired bearer token, also once it expires during the call. Nothing is claimed or delivered for it; a retry with a valid token replays a recorded outcome.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "WWW-Authenticate": {
                "required": true,
                "schema": {
                  "enum": [
                    "Bearer"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "unauthorized"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "No active grant, a disabled target, or a release the publisher can no longer run.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "required": true,
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Weft-Invocation-Replayed": {
                "description": "Whether this answer replays an outcome recorded by an earlier call; present for a recorded refusal.",
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "refused"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "`conflict`: another body or client application under this request ID. `inProgress`: an attempt for this ID is running; retry after `Retry-After`.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "required": true,
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "description": "Seconds to wait before retrying; present for `inProgress`.",
                "schema": {
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "conflict",
                        "inProgress"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "The call completed, but its retained response has expired.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "required": true,
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Weft-Invocation-Replayed": {
                "description": "Whether this answer replays an outcome recorded by an earlier call.",
                "required": true,
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "expired"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "The body exceeds 2097152 bytes. Nothing is recorded.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "requestTooLarge"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON, or has a content encoding. Nothing is recorded.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "unsupportedMediaType"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "A recorded mapping outcome; the same request returns it again.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "required": true,
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Weft-Invocation-Replayed": {
                "description": "Whether this answer replays an outcome recorded by an earlier call.",
                "required": true,
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "invalidInput",
                        "invalidParameter",
                        "executionFailed",
                        "resourceLimit",
                        "unsupported"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "A recorded failure; use a new request ID.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "required": true,
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Weft-Invocation-Replayed": {
                "description": "Whether this answer replays an outcome recorded by an earlier call.",
                "required": true,
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "integrityFailure",
                        "interrupted",
                        "attemptsExhausted"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Nothing was recorded as final; retry the same request after `Retry-After`. `Weft-Request-Id` is present once the call reached the ledger.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "required": true,
                "schema": {
                  "pattern": "^[1-9][0-9]*$",
                  "type": "string"
                }
              },
              "Weft-Request-Id": {
                "description": "The admitted request ID.",
                "schema": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/MappingInvocationErrorV1"
                    }
                  ],
                  "properties": {
                    "outcome": {
                      "enum": [
                        "busy",
                        "unavailable",
                        "releaseChanged",
                        "deadline",
                        "noRelease"
                      ],
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "machineToken": [
              "{audience}/.default"
            ]
          }
        ]
      }
    },
    "/v1/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe.",
        "operationId": "GetLiveness",
        "responses": {
          "204": {
            "description": "The process serves requests.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe.",
        "operationId": "GetReadiness",
        "responses": {
          "204": {
            "description": "Started, and the compiled runtime admits work.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Not yet started, stopping, or the compiled runtime has closed.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "required": true,
                "schema": {
                  "enum": [
                    "nosniff"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MappingDocumentInvocationInputV1": {
        "required": [
          "content",
          "mediaType"
        ],
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "format": "byte"
          },
          "mediaType": {
            "enum": [
              "application/json",
              "application/edi-x12",
              "application/edifact",
              "text/csv",
              "text/tab-separated-values"
            ],
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "csvDialect": {
            "required": [
              "schema",
              "delimiter",
              "quote",
              "quoteDisabled",
              "hasHeaderRow",
              "utf8Bom",
              "preserveEmptyStrings"
            ],
            "type": "object",
            "properties": {
              "schema": {
                "enum": [
                  "weft.csv-dialect.v1"
                ],
                "type": "string"
              },
              "delimiter": {
                "type": "string"
              },
              "quote": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "quoteDisabled": {
                "type": "boolean"
              },
              "hasHeaderRow": {
                "type": "boolean"
              },
              "utf8Bom": {
                "type": "boolean"
              },
              "preserveEmptyStrings": {
                "type": "boolean"
              }
            },
            "description": "Resolved saved CSV settings. Delimiter and quote are single ASCII characters; disabled quoting requires null quote. A tab delimiter identifies TSV. All fields are required."
          }
        },
        "additionalProperties": false
      },
      "MappingDocumentInvocationOutputV1": {
        "required": [
          "name",
          "sha256",
          "mediaType",
          "content"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "mediaType": {
            "enum": [
              "application/json",
              "application/edi-x12",
              "application/edifact",
              "text/csv",
              "text/tab-separated-values"
            ],
            "type": "string"
          },
          "csvDialect": {
            "required": [
              "schema",
              "delimiter",
              "quote",
              "quoteDisabled",
              "hasHeaderRow",
              "utf8Bom",
              "preserveEmptyStrings"
            ],
            "type": "object",
            "properties": {
              "schema": {
                "enum": [
                  "weft.csv-dialect.v1"
                ],
                "type": "string"
              },
              "delimiter": {
                "type": "string"
              },
              "quote": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "quoteDisabled": {
                "type": "boolean"
              },
              "hasHeaderRow": {
                "type": "boolean"
              },
              "utf8Bom": {
                "type": "boolean"
              },
              "preserveEmptyStrings": {
                "type": "boolean"
              }
            },
            "description": "Resolved saved CSV settings. Delimiter and quote are single ASCII characters; disabled quoting requires null quote. A tab delimiter identifies TSV. All fields are required."
          },
          "content": {
            "type": "string",
            "format": "byte"
          }
        }
      },
      "MappingDocumentInvocationRequestV1": {
        "required": [
          "schema",
          "inputs"
        ],
        "type": "object",
        "properties": {
          "schema": {
            "enum": [
              "weft.document-invocation-request.v1"
            ],
            "type": "string"
          },
          "inputs": {
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "items": {
              "required": [
                "content",
                "mediaType"
              ],
              "type": "object",
              "properties": {
                "content": {
                  "type": "string",
                  "format": "byte"
                },
                "mediaType": {
                  "enum": [
                    "application/json",
                    "application/edi-x12",
                    "application/edifact",
                    "text/csv",
                    "text/tab-separated-values"
                  ],
                  "type": "string"
                },
                "name": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "csvDialect": {
                  "required": [
                    "schema",
                    "delimiter",
                    "quote",
                    "quoteDisabled",
                    "hasHeaderRow",
                    "utf8Bom",
                    "preserveEmptyStrings"
                  ],
                  "type": "object",
                  "properties": {
                    "schema": {
                      "enum": [
                        "weft.csv-dialect.v1"
                      ],
                      "type": "string"
                    },
                    "delimiter": {
                      "type": "string"
                    },
                    "quote": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "quoteDisabled": {
                      "type": "boolean"
                    },
                    "hasHeaderRow": {
                      "type": "boolean"
                    },
                    "utf8Bom": {
                      "type": "boolean"
                    },
                    "preserveEmptyStrings": {
                      "type": "boolean"
                    }
                  },
                  "description": "Resolved saved CSV settings. Delimiter and quote are single ASCII characters; disabled quoting requires null quote. A tab delimiter identifies TSV. All fields are required."
                }
              },
