{
  "name": "braid",
  "description": "braid — understand, test, and deploy your data mappings.",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "22.23.3",
    "npm": "12.1.0"
  },
  "scripts": {
    "dev": "npm --workspace @braid/web run dev",
    "build": "npm --workspace @braid/web run build",
    "build:browser-session-probe": "npm --workspace @braid/web run build:browser-session-probe",
    "check": "npm run format:check && npm run check:dependency-security && npm run check:mfd-interchange && npm run check:browser-fixture && npm run check:docs-images && npm run contracts:check && npm --workspace @braid/web run check:chat-types && npm --workspace @braid/web run check && npm --workspace @braid/web run check:browser && npm run check:browser-session-probe",
    "check:tooling": "python3 -m unittest discover -s tools/ci -p 'test_*.py' && python3 -m unittest discover -s tools/browser-fixture -p 'test_launch.py' && python3 -m unittest discover -s tools/build-worker -p 'test_*.py'",
    "test": "python3 tools/ci/run_tests.py --group fast",
    "check:dependency-security": "node --test tools/dependency-security.test.mjs",
    "test:dependency-security-browser": "node node_modules/@playwright/test/cli.js test --config apps/web/playwright.dependency-security.config.ts",
    "check:mfd-interchange": "node --experimental-strip-types --test tools/mfd-interchange-tests.mjs",
    "check:browser-fixture": "node --experimental-strip-types --test tools/browser-fixture/security-headers.test.mjs tools/browser-fixture/editor-dev-server.test.mjs tools/browser-fixture/dev-editor-policy.test.mjs tools/browser-fixture/csv-document.test.mjs tools/browser-fixture/xml-document.test.mjs tools/browser-fixture/preview-unsent.test.mjs tools/browser-fixture/sandbox-owner.test.mjs tools/browser-fixture/edi-segments.test.mjs tools/browser-fixture/schema.test.mjs tools/browser-fixture/failure-site.test.mjs tools/browser-fixture/safe-diagnostics.test.mjs tools/browser-fixture/test-subnets.test.mjs tools/hosted-acceptance/model.test.mjs tools/hosted-acceptance/endpoint-settlement.test.mjs tools/hosted-acceptance/acceptance-lifecycle.test.mjs tools/hosted-acceptance/test-subnets.test.mjs tools/hosted-acceptance/public-client.test.mjs",
    "check:browser-session-probe": "npm --workspace @braid/web run check:browser-session-probe",
    "check:docs-images": "node --test tools/docs-images/check.test.mjs && node tools/docs-images/check.mjs",
    "contracts:generate": "npm --prefix tools/contracts-generator run generate",
    "contracts:check": "npm --prefix tools/contracts-generator run check && node tools/contracts-generator/check-specifications.mjs && npm --workspace @braid/web run check:contracts",
    "format": "prettier --write \"apps/web/**/*.{ts,html,css,json}\" \"tools/**/*.{mjs,json}\" package.json global.json",
    "test:browser": "python3 tools/browser-fixture/launch.py --",
    "test:spec-intake-browser": "npm --workspace @braid/web run test:e2e -- --config playwright.spec-intake.config.ts",
    "test:browser-session": "python3 tools/browser-fixture/launch.py -- --config playwright.browser-session.config.ts",
    "test:auth-https-stage-diagnostics": "node --experimental-strip-types --test tools/auth-browser-stage-diagnostics.test.mjs",
    "test:auth-https-source": "npm run test:auth-https-stage-diagnostics && npm --workspace @braid/web run test:e2e -- --config playwright.auth-https-source.config.ts",
    "test:auth-https-browser": "python3 tools/browser-fixture/launch.py --no-core-dumps --display-from-env -- --config playwright.auth-https.config.ts",
    "test:sandbox-browser": "npm --workspace @braid/web run test:e2e -- --config playwright.sandbox.config.ts",
    "test:catalog-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.catalog.config.ts",
    "test:reports-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.reports.config.ts",
    "test:mapping-viewer-browser": "python3 tools/browser-fixture/launch.py -- --config tests/mapping-viewer.config.ts",
    "test:project-creation-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.project-creation.config.ts",
    "test:mapping-metadata-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.mapping-metadata.config.ts",
    "test:native-mapping-upload-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.native-mapping-upload.config.ts",
    "test:native-revision-append-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.native-revision-append.config.ts",
    "format:check": "prettier --check \"apps/web/**/*.{ts,html,css,json}\" \"tools/**/*.{mjs,json}\" package.json global.json"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.4"
    }
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
