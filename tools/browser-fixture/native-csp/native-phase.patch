+// Experimental accounting for one explicitly enrolled producer tree. Not a
+// Chromium collector. Never interprets an empty set as browser-wide coverage.
+#pragma once
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <utility>
+
+namespace braid::probe {
+class Scope {
+  struct State {
+    std::mutex lock;
+    unsigned count = 0;
+    bool lost = false, sealed = false;
+  };
+ public:
+  enum class Status { Open, Pending, ClosedLocalOnly, Failed };
+  class Credit {
+    friend class Scope;
+    explicit Credit(std::shared_ptr<State> s) : state_(std::move(s)) {}
+    std::shared_ptr<State> state_;
+    void End(bool lost) {
+      auto s = std::move(state_);
+      if (!s) return;
+      std::lock_guard guard(s->lock);
+      s->lost |= lost;
+      --s->count;
+    }
+   public:
+    Credit(Credit&&) = default;
+    Credit& operator=(Credit&&) = delete;
+    Credit(const Credit&) = delete;
+    ~Credit() { End(true); } // A discarded closure cannot appear delivered.
+    // Single-owner token. Split before publishing a child, not on arrival.
+    std::optional<Credit> Child() const {
+      auto s = state_;
+      if (!s) return {};
+      std::lock_guard guard(s->lock);
+      if (s->lost || s->count >= 4096) { s->lost = true; return {}; }
+      ++s->count;
+      return Credit(s);
+    }
+    // Local producer completion only; not native DOM dispatch or Node receipt.
+    void Completed() { End(false); }
+  };
+  Scope() = default;
+  Scope(const Scope&) = delete;
+  std::optional<Credit> Root() {
+    std::lock_guard guard(state_->lock);
+    if (state_->lost || state_->sealed || state_->count >= 4096) {
+      state_->lost = true; return {};
+    }
+    ++state_->count;
+    return Credit(state_);
+  }
+  void SealIngress() { std::lock_guard guard(state_->lock); state_->sealed = true; }
+  Status Inspect() const {
+    std::lock_guard guard(state_->lock);
+    if (state_->lost) return Status::Failed;
+    if (!state_->sealed) return Status::Open;
+    return state_->count ? Status::Pending : Status::ClosedLocalOnly;
+  }
+ private:
+  std::shared_ptr<State> state_ = std::make_shared<State>();
+};
+}
