        "sourceCodeHtml": "\n&lt;?xml version=\"1.0\"?><br/>\n<br/>\n&lt;?xml-stylesheet&nbsp;&nbsp;&nbsp;href=\"doc.xsl\"<br/>\n&nbsp;&nbsp;&nbsp;type=\"text/xsl\"&nbsp;&nbsp;&nbsp;?><br/>\n<br/>\n&lt;!DOCTYPE doc SYSTEM \"doc.dtd\"><br/>\n<br/>\n&lt;doc>Hello, world!&lt;!-- Comment 1 -->&lt;/doc><br/>\n<br/>\n&lt;?pi-without-data&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;?><br/>\n<br/>\n&lt;!-- Comment 2 --><br/>\n<br/>\n&lt;!-- Comment 3 --><br/>\n",
