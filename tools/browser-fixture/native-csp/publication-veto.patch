+// Deliberately coarser than reaction identity: a single publication anywhere
+// on the original isolate disqualifies a promise-free load. Never decrement
+// on resolve/after: a handler may have transferred work to a host subsystem.
+void FixtureHook(v8::PromiseHookType type,
+                 v8::Local<v8::Promise>,
+                 v8::Local<v8::Value>) {
+  auto* tracker = TaskAttributionTracker::From(v8::Isolate::GetCurrent());
+  if (tracker) {
+    tracker->NoteFixturePublication(1);
+  }
+}
+void CombinedHook(v8::PromiseHookType type,
+                  v8::Local<v8::Promise> promise,
+                  v8::Local<v8::Value> parent) {
+  FixtureHook(type, promise, parent);
+  TaskAttributionPromiseHook(type, promise, parent);
+}
 }  // namespace
+
+uint64_t TaskAttributionTrackerImpl::ArmFixturePublicationVeto() {
+  if (!fixture_observing_) {
+    fixture_observing_ = true;
+    isolate_->SetPromiseHook(tracing_promise_hook_ ? CombinedHook
+                                                   : FixtureHook);
+  }
+  return fixture_revision_;
+}
 
