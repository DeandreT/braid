<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <ProjectReference Include="../Weft.Contracts/Weft.Contracts.csproj" />
    <ProjectReference Include="../Weft.Application/Weft.Application.csproj" />
    <ProjectReference Include="../Weft.Domain/Weft.Domain.csproj" />
    <ProjectReference Include="../Weft.Deployment/Weft.Deployment.csproj" />
    <ProjectReference Include="../Weft.Identity/Weft.Identity.csproj" />
    <ProjectReference Include="../Weft.MappingBackends/Weft.MappingBackends.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../engines/ferrule-host/tests/fixtures/*.json"
                      LogicalName="Weft.Api.NativeExamples.%(Filename)%(Extension)" />
    <EmbeddedResource Include="NativeExamples/Artifacts/*.json"
                      LogicalName="Weft.Api.NativeExamples.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The user guide ships inside the server build; nothing is read from disk at run time. -->
    <EmbeddedResource Include="../../../docs/user-guide/*.md"
                      LogicalName="Weft.Api.UserGuide.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
