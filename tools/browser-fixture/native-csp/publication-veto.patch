+protocol::Response InspectorAuditsAgent::readBraidBoundedLoad(
+    const String& epoch,
+    String* generation,
+    String* producer) {
+  auto* doc = braid_document_.Get();
+  auto* tracker = doc && doc->domWindow()
+                      ? scheduler::TaskAttributionTracker::From(
+                            doc->domWindow()->GetIsolate())
+                      : nullptr;
+  if (!tracker || fixture_publication_baseline_ == UINT64_MAX ||
+      tracker->FixturePublicationRevision() != fixture_publication_baseline_) {
+    braid_refused_ = true;
+    return protocol::Response::ServerError(
+        !tracker ? "unowned fixture publication: no tracker"
+        : tracker->FixtureLastPublication() == 1
+            ? "unowned fixture publication: promise"
+        : tracker->FixtureLastPublication() == 2
+            ? "unowned fixture publication: port"
+            : tracker->FixtureLastPublication() == 3 ? "unowned fixture publication: resource" : "unowned fixture publication: database");
+  }
+  return readBraidZero(epoch, generation, producer);
