+// Browser UI-sequence authority for this *document* inventory. Renderer
+// producers are not inferred from it. Native clean admission is intentionally absent.
+struct BraidInventory {
+  std::string run,epoch,snapshot,prepared_digest,checkpoint,failure;
+  std::array<uint8_t,32> key{};
+  std::vector<std::string> records;
+  std::set<std::string> live;
+  int prepared_revision = 0;
+  bool context_gone = false, verified = false;
+  void Fail(std::string why) { if (failure.empty()) failure=std::move(why); }
+  std::string Records() const {return base::JoinString(records,"\n");}
+  std::string Digest() const {return base::HexEncodeLower(crypto::hash::Sha256(run+":"+epoch+":"+Records()));}
+};
+namespace {
+const int kBraidSlot = 0;
+struct BraidSlot : base::SupportsUserData::Data {
+  std::shared_ptr<BraidInventory> run;
+  ~BraidSlot() override {if(run)run->context_gone=true;}
+};
+bool BraidHex(const std::string& value,size_t length) {
+  return value.size()==length && value.find_first_not_of("0123456789abcdef")==std::string::npos;
+}
+}
+void BraidDocumentTransition(RenderFrameHostImpl& frame,const blink::DocumentToken& token,bool birth) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* ctx=frame.GetBrowserContext();
+  if(!ctx->IsOffTheRecord())return;
+  auto* slot=static_cast<BraidSlot*>(ctx->GetUserData(&kBraidSlot));
+  // One persistent marker rejects late admission even when every old page is gone.
+  if(!slot){ctx->SetUserData(&kBraidSlot,std::make_unique<BraidSlot>());return;}
+  if(!slot->run)return;
+  auto& r=*slot->run;
+  if(r.records.size()>=512){r.Fail("inventory-limit");return;}
+  std::string id=token.ToString();
+  if(birth){if(!r.snapshot.empty())r.Fail("late-document");if(!r.live.insert(id).second)r.Fail("duplicate-document");}
+  else if(!r.live.erase(id))r.Fail("unknown-disposal");
+  auto* parent=frame.GetParent();
+  // The parent may itself be speculative; its frame-tree node is not a document token.
+  r.records.push_back(std::string(birth?"B:":"D:")+id+":"+base::NumberToString(frame.GetFrameTreeNodeId().value())+":"+
+    base::NumberToString(frame.GetProcess()->GetID().value())+":"+(parent?base::NumberToString(parent->GetFrameTreeNodeId().value()):"-"));
+}
+Response BrowserHandler::BeginBraidInventory(const std::string& context,const std::string& epoch,const std::string& public_key,std::string* run) {
+  if(!braid_browser_session_ || braid_ || !BraidHex(epoch,32))return Response::ServerError("invalid browser enrollment");
+  BrowserContext* ctx=nullptr;auto found=FindBrowserContext(context,&ctx);if(!found.IsSuccess())return found;
+  if(!ctx->IsOffTheRecord() || ctx->GetUserData(&kBraidSlot))return Response::ServerError("context already used");
+  auto slot=std::make_unique<BraidSlot>();braid_=std::make_shared<BraidInventory>();slot->run=braid_;
+  if(!BraidHex(public_key,64) || !base::HexStringToSpan(public_key,braid_->key)){braid_.reset();return Response::ServerError("invalid receipt key");}
+  braid_->epoch=epoch;*run=braid_->run=base::UnguessableToken::Create().ToString();ctx->SetUserData(&kBraidSlot,std::move(slot));return Response::Success();
+}
+Response BrowserHandler::ReadBraidInventory(const std::string& run,int* rev,std::string* records,std::string* digest) {
+  if(!braid_ || braid_->run!=run)return Response::ServerError("unknown run");
+  *rev=static_cast<int>(braid_->records.size());*records=braid_->Records();*digest=braid_->Digest();return Response::Success();
+}
+Response BrowserHandler::PrepareBraidFence(const std::string& run,int revision,const std::string& inventory,const std::string& digest,const std::string& checkpoint,std::string* ticket,std::string* disposition) {
+  if(!braid_ || braid_->run!=run)return Response::ServerError("unknown run");auto& r=*braid_;
+  if(!r.snapshot.empty()){r.Fail("duplicate-prepare");return Response::ServerError("already prepared");}
+  r.prepared_revision=static_cast<int>(r.records.size());r.prepared_digest=r.Digest();r.checkpoint=checkpoint;
+  if(revision!=r.prepared_revision || inventory!=r.Records() || digest!=r.prepared_digest)r.Fail("inventory-mismatch");
+  // Prefix 1 is the fsynced inventory checkpoint of this single-use fence.
+  // Do not equate a hex digest or a valid signature with renderer coverage.
+  if(checkpoint.size()!=195 || !checkpoint.starts_with("1:") || checkpoint[66]!=':' || !BraidHex(checkpoint.substr(2,64),64))r.Fail("missing-durable-checkpoint");
+  else {
+    std::array<uint8_t,64> signature{};
+    const std::string message="braid-fence-v1:"+run+":"+r.epoch+":"+base::NumberToString(revision)+":"+digest+":"+checkpoint.substr(0,66);
+    if(!base::HexStringToSpan(checkpoint.substr(67),signature) || !crypto::sign::Verify(crypto::sign::ED25519,
+       crypto::keypair::PublicKey::FromEd25519PublicKey(r.key),base::as_byte_span(message),signature))r.Fail("invalid-checkpoint-proof");
+  }
+  if(r.live.empty() || r.context_gone)r.Fail("no-live-original");
+  *ticket=r.snapshot=base::UnguessableToken::Create().ToString();
+  *disposition=r.failure.empty()?"renderer-producer-coverage-unproven":r.failure;
+  return Response::Success();
+}
+Response BrowserHandler::VerifyBraidDisposal(const std::string& run,int revision,const std::string& ticket,const std::string& digest,const std::string& checkpoint,bool* disposed,std::string* disposition,int* current,std::string* transitions){
+  if(!braid_ || braid_->run!=run)return Response::ServerError("unknown run");auto& r=*braid_;
+  if(r.verified || r.snapshot.empty() || ticket!=r.snapshot || revision!=r.prepared_revision || digest!=r.prepared_digest || checkpoint!=r.checkpoint)r.Fail("invalid-fence-echo");
+  *current=static_cast<int>(r.records.size()); *transitions=base::JoinString(std::vector<std::string>(r.records.begin()+r.prepared_revision,r.records.end()),"\n");
+  r.verified=true;*disposed=r.context_gone && r.live.empty();if(!*disposed)r.Fail("originals-not-disposed");
+  *disposition=r.failure.empty()?"renderer-producer-coverage-unproven":r.failure;return Response::Success();
+}
