+  ~ScopedFixtureLifecycleCallback() {
+    if (ingress_) {
+      ingress_->Leave(id_);
+    }
+  }
+
+ private:
+  std::shared_ptr<FixtureIngress> ingress_;
+  FixtureIngress::Id id_ = 0;
+};
 
