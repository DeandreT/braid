{
  "name": "@braid/web",
  "description": "braid mapping workspace frontend.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 5173 --proxy-config proxy.conf.json",
    "check": "ng build --configuration development",
    "check:contracts": "tsc -p tsconfig.contracts.json",
    "check:browser": "tsc -p tsconfig.browser.json",
    "check:chat-types": "playwright test --config playwright.workspace-chat-node.config.ts",
    "check:browser-session-probe": "ng run braid:browser-session-probe:development",
    "build": "ng build",
    "build:browser-session-probe": "ng run braid:browser-session-probe:production",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
