+void BindBraidReceiver(RenderFrameHost* host,mojo::PendingReceiver<blink::mojom::BraidReceiver> pipe){
+  auto* f=static_cast<RenderFrameHostImpl*>(host);auto* slot=static_cast<BraidSlot*>(f->GetBrowserContext()->GetUserData(&kBraidSlot));
+  if(!slot||!slot->run||!slot->run->nav_enabled||!f->IsActive())return;
+  if(++slot->run->opened_loaders>2048){slot->run->Fail("receiver-limit");return;}
+  new OriginalFetchReceiver(*f,std::move(pipe),slot->run);
+}
