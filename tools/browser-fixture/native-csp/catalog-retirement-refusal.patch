+const BraidResourceFactory*& CurrentBraidFactory(){static thread_local const BraidResourceFactory* factory=nullptr;return factory;}
+BraidResourceFactory BraidFactoryForDocument(RenderFrameHostImpl& frame){
+  auto* ctx=frame.GetBrowserContext();auto* slot=static_cast<BraidSlot*>(ctx->GetUserData(&kBraidSlot));
+  if(!slot||!slot->run||!slot->run->nav_enabled)return {};
+  // Bound to this factory's original document, never looked up by current frame at job arrival.
+  auto token=frame.GetDocumentTokenIgnoringSafetyRestrictions().ToString();
+  return base::BindRepeating([](std::shared_ptr<BraidInventory> r,std::string generation)->base::OnceCallback<void(bool)>{
+    if(r->issued_resources>=2048||!r->live.contains(generation)||!r->snapshot.empty()){r->resource_lost=true;r->Fail("unowned-resource");return {};}
+    int id=++r->issued_resources;r->pending_resources.insert(id);r->resource_log.push_back("S:"+base::NumberToString(id)+":"+generation);
+    r->outstanding_receivers.emplace(id,generation);
+    r->resource_log.push_back("R:"+base::NumberToString(id)+":"+generation);
+    return base::BindOnce([](std::shared_ptr<BraidInventory> run,std::string original,int credit,bool ok){
+      if(run->pending_resources.erase(credit)!=1||!ok||!run->live.contains(original)){run->resource_lost=true;run->Fail("resource-lost");return;}
+      ++run->forwarded_resources;run->resource_log.push_back("F:"+base::NumberToString(credit)+":"+original);
+    },r,generation,id);
+  },slot->run,token);
+}
+void BraidBeginNavigation(NavigationRequest& request) {
+  auto* frame=request.frame_tree_node()->current_frame_host();auto* ctx=frame->GetBrowserContext();
+  auto* slot=static_cast<BraidSlot*>(ctx->GetUserData(&kBraidSlot));if(!slot||!slot->run||!slot->run->nav_enabled)return;
