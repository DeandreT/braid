+// Qualification-only worker lifecycle accounting. This is not a browser cutoff.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_WORKERS_CSP_FIXTURE_WORKER_LIFECYCLE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_WORKERS_CSP_FIXTURE_WORKER_LIFECYCLE_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+#include "third_party/blink/renderer/core/frame/csp/credit_scope.h"
+
+namespace braid::probe {
+
+class WorkerCspLedger {
+ public:
+  enum class Refusal {
+    kNone,
+    kLateIngress,
+    kGenerationLimit,
+    kUnadmittedStart,
+    kUnsupportedWorker,
+    kUnsupportedWorklet,
+    kOutsideSettingsDispatch,
+    kUnresolvedStart,
+    kInvalidTransition,
+    kForcedDisposal,
+    kUnsettledDispatch,
+    kLiveProducer,
+  };
+  using Id = uint64_t;
+
+ private:
+  static constexpr size_t kMaxGenerations = 256;
+
+  struct State {
+    void Refuse(Refusal reason) {
+      if (refusal == Refusal::kNone) {
+        refusal = reason;
+      }
+    }
+
+    std::mutex lock;
+    bool sealed = false;
+    Refusal refusal = Refusal::kNone;
+    unsigned live = 0;
+    // Retain the terminal dispatch scopes so that a late root on a retired
+    // generation cannot disappear from subsequent checks.
+    std::array<std::shared_ptr<Scope>, kMaxGenerations> scopes;
+    size_t generations = 0;
+  };
+
+ public:
+  // One owner, transferred from the creator to the worker before it can run.
+  // Its methods must not be called concurrently. The ledger and dispatch scope
+  // are independently synchronized and safe to inspect from the fixture owner.
+  class Generation {
+   public:
+    Generation(const Generation&) = delete;
+    Generation& operator=(const Generation&) = delete;
+    ~Generation() {
+      if (phase_ == Phase::kRetired) {
+        return;
+      }
+      std::lock_guard guard(state_->lock);
+      state_->Refuse(phase_ == Phase::kReserved || phase_ == Phase::kBound
+                         ? Refusal::kUnresolvedStart
+                         : Refusal::kForcedDisposal);
+      --state_->live;
+    }
+
+    Id id() const { return id_; }
+
+    // Call once, before binding the execution-context CSP to its delegate.
+    std::shared_ptr<Scope> Bind() {
+      if (phase_ != Phase::kReserved) {
+        Refuse(Refusal::kInvalidTransition);
+        return nullptr;
+      }
+      phase_ = Phase::kBound;
+      return scope_;
+    }
+
+    void TopLevelEvaluated(bool success) {
+      if (phase_ != Phase::kBound) {
+        Refuse(Refusal::kInvalidTransition);
+        return;
+      }
+      if (!success) {
+        Refuse(Refusal::kUnresolvedStart);
+        return;
+      }
+      phase_ = Phase::kRunning;
+    }
+
+    void BeginDisposal() {
+      if (phase_ != Phase::kRunning) {
+        Refuse(phase_ == Phase::kReserved || phase_ == Phase::kBound
+                   ? Refusal::kUnresolvedStart
+                   : Refusal::kInvalidTransition);
+      }
+      if (phase_ != Phase::kRetired) {
+        phase_ = Phase::kDisposing;
+      }
+      scope_->SealIngress();
+    }
+
+    void FinishDisposal(bool graceful) {
+      if (phase_ != Phase::kDisposing) {
+        Refuse(Refusal::kInvalidTransition);
+        return;
+      }
+      std::lock_guard guard(state_->lock);
+      if (!graceful) {
+        state_->Refuse(Refusal::kForcedDisposal);
+      }
+      if (scope_->Inspect() != Scope::Status::ClosedLocalOnly) {
+        state_->Refuse(Refusal::kUnsettledDispatch);
+      }
+      phase_ = Phase::kRetired;
+      --state_->live;
+    }
+
+    void Refuse(Refusal reason) {
+      std::lock_guard guard(state_->lock);
+      state_->Refuse(reason);
+    }
+
+   private:
+    friend class WorkerCspLedger;
+    enum class Phase { kReserved, kBound, kRunning, kDisposing, kRetired };
+    Generation(std::shared_ptr<State> state,
+               std::shared_ptr<Scope> scope,
+               Id id)
+        : state_(std::move(state)), scope_(std::move(scope)), id_(id) {}
+
+    const std::shared_ptr<State> state_;
+    const std::shared_ptr<Scope> scope_;
+    const Id id_;
+    Phase phase_ = Phase::kReserved;
+  };
+
+  WorkerCspLedger() = default;
+  WorkerCspLedger(const WorkerCspLedger&) = delete;
+  WorkerCspLedger& operator=(const WorkerCspLedger&) = delete;
+
+  std::unique_ptr<Generation> Reserve() {
+    std::lock_guard guard(state_->lock);
+    if (state_->sealed) {
+      state_->Refuse(Refusal::kLateIngress);
+    }
+    if (state_->generations == kMaxGenerations) {
+      state_->Refuse(Refusal::kGenerationLimit);
+    }
+    if (state_->refusal != Refusal::kNone) {
+      return nullptr;
+    }
+    auto scope = std::make_shared<Scope>();
+    state_->scopes[state_->generations++] = scope;
+    ++state_->live;
+    return std::unique_ptr<Generation>(
+        new Generation(state_, std::move(scope), state_->generations));
+  }
+
+  void Refuse(Refusal reason) {
+    std::lock_guard guard(state_->lock);
+    state_->Refuse(reason);
+  }
+
+  // Terminal local check, not a drain operation. Calling it with outstanding
+  // work is a sticky refusal, even if that work eventually finishes. Caller
+  // still owes an ingress fence, remote producer inventory, and receipt proof.
+  Refusal SealAndCheckTerminal() {
+    std::lock_guard guard(state_->lock);
+    state_->sealed = true;
+    if (state_->live != 0) {
+      state_->Refuse(Refusal::kLiveProducer);
+    }
+    for (size_t i = 0; i < state_->generations; ++i) {
+      if (state_->scopes[i]->Inspect() != Scope::Status::ClosedLocalOnly) {
+        state_->Refuse(Refusal::kUnsettledDispatch);
+      }
+    }
+    return state_->refusal;
+  }
+
+ private:
+  const std::shared_ptr<State> state_ = std::make_shared<State>();
+};
+
+}  // namespace braid::probe
+
