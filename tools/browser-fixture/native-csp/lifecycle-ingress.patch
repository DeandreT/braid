+    if (visibility || type == event_type_names::kFocus ||
+        type == event_type_names::kBlur ||
+        type == event_type_names::kBeforeunload ||
+        type == event_type_names::kPagehide ||
+        type == event_type_names::kPageshow ||
+        type == event_type_names::kUnload) {
+      return window->FixtureLifecycleIngress();
+    }
+  } else if (visibility) {
+    if (auto* doc = DynamicTo<Document>(target.ToNode())) {
+      if (auto* window = doc->domWindow()) {
+        auto ingress = window->FixtureLifecycleIngress();
+        if (ingress && window->document() != doc) {
+          ingress->Refuse(FixtureIngress::Failure::kWrongOriginal);
