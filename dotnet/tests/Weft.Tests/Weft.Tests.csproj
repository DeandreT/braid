<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Weft.Api/Weft.Api.csproj" />
    <ProjectReference Include="../../src/Weft.Application/Weft.Application.csproj" />
    <ProjectReference Include="../../src/Weft.Domain/Weft.Domain.csproj" />
    <ProjectReference Include="../../src/Weft.Contracts/Weft.Contracts.csproj" />
    <ProjectReference Include="../../src/Weft.MappingBackends/Weft.MappingBackends.csproj" />
    <ProjectReference Include="../../src/Weft.Persistence.Postgres/Weft.Persistence.Postgres.csproj" />
    <ProjectReference Include="../../src/Weft.Storage.FileSystem/Weft.Storage.FileSystem.csproj" />
    <ProjectReference Include="../../tools/Weft.StorageProbe/Weft.StorageProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../apps/Weft.Server/Weft.Server.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../engines/ferrule-host/tests/fixtures/*.json"
          Link="FerruleFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Weft.Api/NativeExamples/Artifacts/*.json"
          Link="FerruleFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyStorageProbe" AfterTargets="Build">
    <ItemGroup>
      <StorageProbeFiles Include="../../tools/Weft.StorageProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StorageProbeFiles)" DestinationFiles="@(StorageProbeFiles->'$(OutDir)StorageProbe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
