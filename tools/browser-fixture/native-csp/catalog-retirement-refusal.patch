+  if(!r.snapshot.empty())r.Fail("late-navigation");
+  auto lease=std::make_unique<NavigationLease>();lease->run=slot->run;lease->id=id;
+  r.nav_log.push_back("S:"+base::NumberToString(id)+":"+frame->GetDocumentToken().ToString());request.SetUserData(&kNavigationLease,std::move(lease));
+}
+void BraidCommitNavigation(NavigationRequest& request,bool success){
+  auto* lease=static_cast<NavigationLease*>(request.GetUserData(&kNavigationLease));if(!lease)return;
