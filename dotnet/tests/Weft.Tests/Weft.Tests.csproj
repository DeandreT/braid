<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Weft.Api/Weft.Api.csproj" />
    <ProjectReference Include="../../src/Weft.Application/Weft.Application.csproj" />
    <ProjectReference Include="../../src/Weft.Domain/Weft.Domain.csproj" />
    <ProjectReference Include="../../src/Weft.Contracts/Weft.Contracts.csproj" />
    <ProjectReference Include="../../src/Weft.MappingBackends/Weft.MappingBackends.csproj" />
    <ProjectReference Include="../../src/Weft.Persistence.Postgres/Weft.Persistence.Postgres.csproj" />
    <ProjectReference Include="../../src/Weft.Storage.FileSystem/Weft.Storage.FileSystem.csproj" />
    <ProjectReference Include="../../tools/Weft.StorageProbe/Weft.StorageProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Weft.StorageTool/Weft.StorageTool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Weft.DatabaseTool/Weft.DatabaseTool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Weft.IngestionProbe/Weft.IngestionProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Weft.RevisionReportMetadataProbe/Weft.RevisionReportMetadataProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/Weft.RevisionReportWorkflowProbe/Weft.RevisionReportWorkflowProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../apps/Weft.Server/Weft.Server.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../engines/ferrule-host/tests/fixtures/*.json"
          Link="FerruleFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Weft.Api/NativeExamples/Artifacts/*.json"
          Link="FerruleFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyStorageProbe" AfterTargets="Build">
    <ItemGroup>
      <StorageProbeFiles Include="../../tools/Weft.StorageProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StorageProbeFiles)" DestinationFiles="@(StorageProbeFiles->'$(OutDir)StorageProbe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyIngestionProbe" AfterTargets="Build">
    <ItemGroup>
      <IngestionProbeFiles Include="../../tools/Weft.IngestionProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(IngestionProbeFiles)" DestinationFiles="@(IngestionProbeFiles->'$(OutDir)IngestionProbe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyStorageTool" AfterTargets="Build">
    <ItemGroup>
      <StorageToolFiles Include="../../tools/Weft.StorageTool/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StorageToolFiles)" DestinationFiles="@(StorageToolFiles->'$(OutDir)StorageTool/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRevisionReportMetadataProbe" AfterTargets="Build">
    <ItemGroup>
      <RevisionReportMetadataProbeFiles Include="../../tools/Weft.RevisionReportMetadataProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RevisionReportMetadataProbeFiles)" DestinationFiles="@(RevisionReportMetadataProbeFiles->'$(OutDir)RevisionReportMetadataProbe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDatabaseTool" AfterTargets="Build">
    <ItemGroup>
      <DatabaseToolFiles Include="../../tools/Weft.DatabaseTool/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DatabaseToolFiles)" DestinationFiles="@(DatabaseToolFiles->'$(OutDir)DatabaseTool/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRevisionReportWorkflowProbe" AfterTargets="Build">
    <ItemGroup>
      <RevisionReportWorkflowProbeFiles Include="../../tools/Weft.RevisionReportWorkflowProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RevisionReportWorkflowProbeFiles)" DestinationFiles="@(RevisionReportWorkflowProbeFiles->'$(OutDir)RevisionReportWorkflowProbe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
