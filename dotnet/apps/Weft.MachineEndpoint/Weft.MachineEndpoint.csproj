<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>weft-mapping-endpoint</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The build writes the endpoint's OpenAPI document from its document-only host. -->
    <OpenApiDocumentsDirectory>../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name weft-endpoint-v1 --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" PrivateAssets="all" />
    <ProjectReference Include="../../src/Weft.Deployment/Weft.Deployment.csproj" />
    <ProjectReference Include="../../src/Weft.Identity/Weft.Identity.csproj" />
    <ProjectReference Include="../../src/Weft.MappingBackends/Weft.MappingBackends.csproj" />
    <ProjectReference Include="../../src/Weft.MappingBackends.AzureSessions/Weft.MappingBackends.AzureSessions.csproj" />
    <ProjectReference Include="../../src/Weft.WorkerTransport/Weft.WorkerTransport.csproj" />
    <ProjectReference Include="../../src/Weft.Persistence.Postgres/Weft.Persistence.Postgres.csproj" />
    <ProjectReference Include="../../src/Weft.Storage.FileSystem/Weft.Storage.FileSystem.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Weft.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The release tool qualifies builds through exactly the endpoint's compiled runtime selection. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Weft.ReleaseTool</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
