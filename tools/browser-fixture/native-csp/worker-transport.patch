+protocol::Response InspectorAuditsAgent::armBraidWorker(const String& epoch, String* generation) {
+  auto* frame = inspected_frames_->Root();
+  auto* doc = frame ? frame->GetDocument() : nullptr;
+  if (braid_refused_ || braid_worker_ || braid_scope_ || epoch.length() != 32 || !doc || !frame->IsMainFrame() ||
+      !doc->domWindow() || doc->Url().GetString() != "http://braid.invalid/worker-fixture") {
+    braid_refused_ = true; return protocol::Response::ServerError("worker fixture refused");
+  }
+  auto state = std::make_shared<WorkerBridge>();
+  state->ledger = InstallWorkerCspFixture(base::BindRepeating([](const std::shared_ptr<WorkerBridge>& bridge,
+      braid::probe::WorkerCspLedger::Id id, const WorkerToken& token, const Event& event) {
+    const auto& csp = static_cast<const SecurityPolicyViolationEvent&>(event);
+    auto* target = event.target();
+    auto* worker = DynamicTo<WorkerGlobalScope>(target ? target->GetExecutionContext() : nullptr);
+    if (id != 1 || !worker || worker != target || token != worker->GetWorkerToken() ||
+        !token.Is<DedicatedWorkerToken>() || !event.isTrusted() || event.eventPhase() != Event::PhaseType::kAtTarget ||
+        csp.effectiveDirective() != "connect-src" || csp.violatedDirective() != "connect-src" ||
+        csp.blockedURI() != "http://braid.invalid/blocked" ||
+        csp.disposition().AsEnum() != V8SecurityPolicyViolationEventDisposition::Enum::kEnforce) return false;
+    std::lock_guard guard(bridge->lock);
+    if (!bridge->dispatch.empty()) return false;
+    bridge->token = token.ToString(); bridge->dispatch = base::UnguessableToken::Create().ToString(); return true;
+  }, state));
+  if (!state->ledger) {braid_refused_ = true; return protocol::Response::ServerError("worker ingress not original");}
+  braid_epoch_ = epoch; braid_document_ = doc; braid_worker_ = std::move(state);
+  *generation = String::FromUtf8(doc->Token().ToString()); return protocol::Response::Success();
+}
+
+protocol::Response InspectorAuditsAgent::readBraidWorker(const String& epoch, bool terminal,
+    String* token, String* dispatch, bool* retired) {
+  auto* frame = inspected_frames_->Root(); auto* doc = braid_document_.Get();
+  std::string worker;
+  if (braid_refused_ || !braid_worker_ || epoch != braid_epoch_ || !doc || !frame || frame->GetDocument() != doc ||
+      !doc->domWindow() || doc->domWindow()->IsContextDestroyed() || !braid_worker_->ledger->SingleReservation(worker, *retired)) {
+    braid_refused_ = true; return protocol::Response::ServerError("original worker unavailable");
+  }
+  *token = String::FromUtf8(worker); *dispatch = String("");
+  if (!terminal || !*retired) return protocol::Response::Success();
+  std::lock_guard guard(braid_worker_->lock);
+  if (braid_worker_->ledger->SealAndCheckTerminal() != braid::probe::WorkerCspLedger::Refusal::kNone ||
+      worker != braid_worker_->token || braid_worker_->dispatch.empty()) {
+    braid_refused_ = true; return protocol::Response::ServerError("worker unsettled");
+  }
+  *dispatch = String::FromUtf8(braid_worker_->dispatch); return protocol::Response::Success();
+}
