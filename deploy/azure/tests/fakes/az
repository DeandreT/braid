#!/usr/bin/env bash
# Recording fake of the Azure CLI for deploy/azure/tests/qualify-test.sh: no network and no Azure. It appends every
# call to $FAKE_STATE/calls.log, keeps the run's state (group, deployments, job executions and their console lines,
# releases, grants and recorded invocations) under $FAKE_STATE, and answers as the commands qualify.sh and
# initialize-secrets.sh use. FAKE_AZ_FAIL makes any call whose arguments contain it fail. A call that does not name
# the approved subscription FAKE_SUBSCRIPTION, or that changes the CLI's default, is refused and written to
# $FAKE_STATE/violations, which the tests require to stay empty. The signed-in account sees only the subscriptions
# in FAKE_VISIBLE_SUBSCRIPTIONS (default: the approved one).
set -euo pipefail
state=$FAKE_STATE
printf 'az %s\n' "$*" >>"$state/calls.log"
arguments=("$@")
subscription_named=false
for ((i = 0; i < ${#arguments[@]} - 1; i++)); do
  if [[ ${arguments[i]} == --subscription ]]; then
    [[ ${arguments[i + 1]} == "$FAKE_SUBSCRIPTION" ]] && subscription_named=true
    break
  fi
done
if [[ ${1:-} == account && ${2:-} == set ]] || ! $subscription_named; then
  printf 'az %s\n' "$*" >>"$state/violations"
  echo 'ERROR: the fake refuses a call that changes the default or does not name the approved subscription' >&2
  exit 2
fi
if [[ -n ${FAKE_AZ_FAIL:-} && " $* " == *"$FAKE_AZ_FAIL"* ]]; then
  echo 'ERROR: injected failure' >&2
  exit 1
fi
# Values the harness must never print or pass as arguments: the scan in the tests reads this list.
[[ -z ${BRAID_POSTGRES_ADMIN_PASSWORD:-} ]] || printf '%s\n' "$BRAID_POSTGRES_ADMIN_PASSWORD" >>"$state/secrets"

option() { # name: the value after the first occurrence
  local i
  for ((i = 0; i < ${#arguments[@]} - 1; i++)); do
    if [[ ${arguments[i]} == "$1" ]]; then
      printf '%s' "${arguments[i + 1]}"
      return 0
    fi
  done
  return 1
}

values() { # name: the values after each occurrence, up to the next option
  local i found=false
  for ((i = 0; i < ${#arguments[@]}; i++)); do
    if [[ ${arguments[i]} == --* ]]; then
      found=false
      [[ ${arguments[i]} == "$1" ]] && found=true
    elif $found; then
      printf '%s\n' "${arguments[i]}"
    fi
  done
}

parameter() { # name: the value of name=value among the deployment's parameters
  values --parameters | sed -n "s/^$1=//p" | tail -n 1
}

has() { # argument
  local argument
  for argument in "${arguments[@]}"; do
    [[ $argument == "$1" ]] && return 0
  done
  return 1
}

b64url() {
  base64 -w0 | tr '+/' '-_' | tr -d '='
}

claims() { # token file
  cut -d. -f2 "$1" | tr '_-' '/+' | awk '{ while (length($0) % 4) $0 = $0 "="; print }' | base64 -d
}

iso() { # epoch
  date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
}

public_host=braid-app.fake-env.eastus2.azurecontainerapps.io

# ---- Job executions ----

execution_start() { # job: prints the new execution name; lines and end state go to $state/executions
  local job=$1 count
  count=$(($(cat "$state/execution-count" 2>/dev/null || echo 0) + 1))
  echo "$count" >"$state/execution-count"
  execution=$job-e$count
  mkdir -p "$state/executions"
  : >"$state/executions/$execution.lines"
}

emit() { # line
  printf '%s\n' "$1" >>"$state/executions/$execution.lines"
}

finish() { # status
  echo "$1" >"$state/executions/$execution.status"
  printf '%s\n' "$execution"
}

release_tool() { # command arguments...
  local command=$1
  shift
  case $command in
    qualify-build)
      if [[ $5 == "$FAKE_BUILD" ]]; then
        echo "$6" >>"$state/qualified"
        emit "{\"outcome\":\"qualified\",\"qualificationId\":\"$6\",\"artifactSha256\":\"$FAKE_ARTIFACT\",\"runtimeImage\":\"$FAKE_RUNTIME_IDENTITY\"}"
        finish Succeeded
      else
        emit '{"outcome":"refused"}'
        finish Failed
      fi
      ;;
    register-release-target)
      emit '{"outcome":"registered"}'
      finish Succeeded
      ;;
    activate-release | rollback-release)
      local release=$8 current
      current=$(cat "$state/current-release" 2>/dev/null || echo none)
      if [[ $command == activate-release ]] && ! grep -qx "$9" "$state/qualified" 2>/dev/null; then
        emit '{"outcome":"refused"}'
        finish Failed
      elif [[ ${10} != "$current" ]]; then
        emit '{"outcome":"conflict"}'
        finish Failed
      else
        echo "$release" >"$state/current-release"
        emit "{\"outcome\":\"activated\",\"releaseId\":\"$release\"}"
        finish Succeeded
      fi
      ;;
    *)
      emit '{"error":"invalidRequest"}'
      finish Failed
      ;;
  esac
}

# The internal endpoint as the caller job reaches it: token, grant, ledger replay and the current release.
caller() { # mode call origin [request credential]
  local mode=$1 name=$2 request=${4:-} credential=${5:-} token status body replayed=false challenge=false now
  if [[ $mode == ready ]]; then
    emit "braid-qualify-call {\"call\":\"$name\",\"status\":204}"
    finish Succeeded
    return
  fi
  token=$state/token-$credential
  now=$(date +%s)
  mkdir -p "$state/responses" "$state/audit"
  if [[ $(claims "$token" | jq -r .aud) != "$FAKE_AUDIENCE" || $(claims "$token" | jq -r .exp) -le $now ]]; then
    status=401 challenge=true body="{\"requestId\":\"$request\",\"outcome\":\"unauthorized\"}"
  elif [[ $(cat "$state/grant" 2>/dev/null) != active ]]; then
    status=403 body="{\"requestId\":\"$request\",\"outcome\":\"refused\"}"
  elif [[ -f $state/responses/$request ]]; then
    status=200 replayed=true body=$(<"$state/responses/$request")
  else
    local release shipment summary
    release=$(<"$state/current-release")
    shipment=$(printf '{\n  "orderId": "SO-1",\n  "region": "west",\n  "generatedAt": "%s",\n  "currency": "EUR",\n  "express": true,\n  "items": [\n    {\n      "sku": "A",\n      "quantity": 2\n    },\n    {\n      "sku": "B",\n      "quantity": 9007199254740993\n    }\n  ]\n}\n' "$(iso "$now")" | base64 -w0)
    summary=$(printf '{\n  "lineCount": 2,\n  "region": "west"\n}\n' | base64 -w0)
    body=$(jq -cn --arg request "$request" --arg release "$release" --arg build "$FAKE_BUILD" --arg artifact "$FAKE_ARTIFACT" \
      --arg clock "$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%S.0000000Z)" --arg shipment "$shipment" --arg summary "$summary" \
      --arg shipmentSha "$(base64 -d <<<"$shipment" | sha256sum | cut -d' ' -f1)" \
      --arg summarySha "$(base64 -d <<<"$summary" | sha256sum | cut -d' ' -f1)" \
      '{schema: "braid.mapping-invocation-response.v1", requestId: $request, releaseId: $release, buildId: $build,
        revisionId: "3a7c4f00-0000-4000-8000-000000000001", artifactDigest: $artifact, currentDateTime: $clock,
        outputs: [{name: null, sha256: $shipmentSha, content: $shipment}, {name: "summary", sha256: $summarySha, content: $summary}]}')
    printf '%s' "$body" >"$state/responses/$request"
    printf '1 claimed -\n2 completed %s\n' "$release" >"$state/audit/$request"
    status=200
  fi
  emit "braid-qualify-call $(jq -cn --arg call "$name" --arg request "$request" --argjson status "$status" \
    --arg replayed "$replayed" --argjson challenge "$challenge" --arg digest "$(printf '%s' "$body" | sha256sum | cut -d' ' -f1)" \
    --argjson body "$body" '{call: $call, requestId: $request, status: $status, attempts: 1, replayed: $replayed,
      bearerChallenge: $challenge, bodySha256: $digest, body: $body}')"
  finish Succeeded
}

job_start() {
  local job args=()
  job=$(option --name)
  mapfile -t args < <(values --args)
  execution_start "$job"
  case $job in
    *-database-roles)
      emit 'The braid database, restricted logins and migrator ownership are provisioned.'
      finish Succeeded
      ;;
    *-migrate) emit 'The Braid database migrations are current.' && finish Succeeded ;;
    *-session-keys) emit 'Bootstrapped' && finish Succeeded ;;
    *-private-storage) emit 'InitializedBlob' && finish Succeeded ;;
    *-owner)
      case ${args[1]} in
        provision-development-identity) emit 'The explicitly configured local identity and requested admission are current.' ;;
        set-project-creation-capability) emit 'Project creation capability granted.' ;;
        # As the database tool: only the Entra user command binds, from the tenant and object ID in the owner input.
        bind-entra-user)
          if jq -e --arg tenant "$FAKE_TENANT" --arg object "$FAKE_OWNER_OBJECT" \
            '. == {tenantId: $tenant, objectId: $object}' "$state/owner-input" >/dev/null 2>&1; then
            emit '{"outcome":"created"}' && finish Succeeded
          else
            emit '{"error":"invalidRequest"}' && finish Failed
          fi
          return
          ;;
        *) emit '{"error":"invalidRequest"}' && finish Failed && return ;;
      esac
      finish Succeeded
      ;;
    *-endpoint-release) release_tool "${args[@]:1}" ;;
    *-endpoint-grants)
      if [[ ${args[1]} == grant-machine-invocation ]]; then
        echo active >"$state/grant" && emit '{"outcome":"granted"}'
      else
        echo revoked >"$state/grant" && emit '{"outcome":"revoked"}'
      fi
      finish Succeeded
      ;;
    *-qualify-caller) caller "${args[@]}" ;;
    *) echo "Unexpected fake job $job" >&2 && exit 2 ;;
  esac
}

# The evidence query: the database-roles job started with the harness's read-only psql command.
database_query() {
  local body sql job
  body=$(option --body)
  job=$(sed -nE 's#^.*/jobs/([^/]+)/start.*$#\1#p' <<<"$(option --url)")
  sql=$(jq -r '.containers[0].command[4]' "${body#@}")
  [[ $(jq -r '.containers[0].command[0:2] | join(" ")' "${body#@}") == 'bash -c' ]] || exit 2
  execution_start "$job"
  if [[ $sql == *'FROM braid.build_runs r JOIN'* ]]; then
    emit "braid-qualify-row $FAKE_PROJECT $FAKE_MAPPING $FAKE_BUILD $FAKE_ENVIRONMENT 1 $FAKE_ARTIFACT t"
  elif [[ $sql == *machine_invocation_audit* ]]; then
    local request
    request=$(sed -nE "s/.*request_id = '([^']+)'.*/\1/p" <<<"$sql" | tail -n 1)
    while read -r line; do emit "braid-qualify-row $line"; done <"$state/audit/$request"
  elif [[ $sql == *chat_conversations* ]]; then
    emit 'braid-qualify-row 1 1 1 1 1 1 1'
  else
    emit 'braid-qualify-row 1 1 1 1 1 1 1'
  fi
  emit braid-qualify-end
  finish Succeeded
}

log_query() {
  local query execution app
  query=$(option --analytics-query)
  execution=$(sed -nE "s/.*ContainerGroupName_s startswith '([^']+)'.*/\1/p" <<<"$query")
  app=$(sed -nE "s/.*ContainerAppName_s == '([^']+)'.*/\1/p" <<<"$query")
  if [[ -n $execution ]]; then
    jq -R -s 'split("\n")[:-1] | map({Log_s: .})' "$state/executions/$execution.lines"
  elif [[ $app == *-app ]]; then
    echo '[{"Log_s": "BraidSessionHostReady"}]'
  elif [[ $app == *-qualify ]]; then
    echo '[{"Log_s": "BraidMappingEndpointReady"}]'
  else
    echo '[]'
  fi
}

deployment_create() {
  local name file
  name=$(option --name)
  touch "$state/deployment-$name"
  if [[ $name == braid-qualify-caller ]]; then
    file=$(values --parameters | sed -n 's/^@//p' | head -n 1)
    for credential in caller foreign expiring; do
      jq -j --arg name "${credential}Token" '.parameters[$name].value' "$file" >"$state/token-$credential"
    done
  elif [[ $name == braid-qualify-endpoints ]]; then
    jq -n --arg endpoints "$(parameter mappingEndpoints)" --arg admin "$(parameter mappingEndpointAdministratorId)" \
      --arg organization "$(parameter organizationId)" --arg tenant "$(parameter entraTenantId)" \
      '$endpoints | fromjson | map(. as $e | $e.callers[] | ["database", "grant-machine-invocation", $admin, $organization,
        $e.projectId, $e.mappingId, $e.environmentId, ($e.environmentVersion | tostring), $e.targetId, .grantId, $tenant, .objectId]
        | join(" "))' >"$state/grant-arguments.json"
  fi
}

deployment_outputs() {
  local name
  name=$(option --name)
  [[ -f $state/deployment-$name ]] || { echo "ERROR: deployment $name not found" >&2 && exit 3; }
  local host='' worker='' origins='[]' grants='[]'
  if [[ $name != braid-qualify-platform ]]; then host=$public_host worker=braid-worker; fi
  if [[ $name == braid-qualify-endpoints ]]; then
    origins='["https://braid-qualify.internal.fake-env.eastus2.azurecontainerapps.io"]'
    grants=$(<"$state/grant-arguments.json")
  fi
  jq -n --arg host "$host" --arg worker "$worker" --argjson origins "$origins" --argjson grants "$grants" '{
    registryName: {type: "String", value: "braidacrfake"}, registryLoginServer: {type: "String", value: "braidacrfake.azurecr.io"},
    keyVaultName: {type: "String", value: "braid-kv-fake"}, databaseHost: {type: "String", value: "braid-pg-fake.postgres.database.azure.com"},
    environmentDefaultDomain: {type: "String", value: "fake-env.eastus2.azurecontainerapps.io"},
    applicationName: {type: "String", value: "braid-app"}, publicHost: {type: "String", value: $host},
    workerName: {type: "String", value: $worker}, mappingEndpointOrigins: {type: "Array", value: $origins},
    mappingEndpointGrantArguments: {type: "Array", value: $grants}}'
}

certificate_download() {
  local file
  file=$(option --file)
  if [[ $(option --encoding) == PEM ]]; then
    openssl x509 -in "$FAKE_CERTIFICATE_PEM" -out "$file"
  else
    openssl x509 -in "$FAKE_CERTIFICATE_PEM" -outform DER -out "$file"
  fi
}

containerapp_show() {
  local name query
  name=$(option --name)
  query=$(option --query || true)
  case $query in
    properties.runningStatus) echo Running ;;
    *minReplicas*) echo "{\"min\": 1, \"max\": 10}" ;;
    '')
      jq -n '{properties: {configuration: {ingress: {external: false, transport: "tcp"}}, template: {containers: [{
        env: [{name: "BRAID_FERRULE_SERVICE_COMPILE_ENABLED", value: "true"}, {name: "BRAID_FERRULE_SERVICE_EXECUTION_ENABLED", value: "true"}],
        probes: [{type: "Startup", httpGet: {path: "/v1/health/ready"}}, {type: "Readiness", httpGet: {path: "/v1/health/ready"}}]}]}}}'
      ;;
    *) echo "Unexpected fake query $query for $name" >&2 && exit 2 ;;
  esac
}

case "$*" in
  'account show'*)
    if [[ " ${FAKE_VISIBLE_SUBSCRIPTIONS:-$FAKE_SUBSCRIPTION} " != *" $FAKE_SUBSCRIPTION "* ]]; then
      echo "ERROR: Subscription '$FAKE_SUBSCRIPTION' not found. Check the spelling and casing and try again." >&2 && exit 1
    fi
    if [[ $(option --query) == tenantId ]]; then echo "${FAKE_ACCOUNT_TENANT:-$FAKE_TENANT}"; else echo "$FAKE_SUBSCRIPTION"; fi
    ;;
  'ad signed-in-user show'*)
    [[ -z ${FAKE_NO_SIGNED_IN_USER:-} ]] || { echo 'ERROR: /me request is only valid with delegated authentication flow.' >&2 && exit 1; }
    echo "$FAKE_OWNER_OBJECT"
    ;;
  'group exists'*) [[ -f $state/group ]] && echo true || echo false ;;
  'group create'*)
    touch "$state/group"
    values --tags | sed -n 's/^braid-qualification-run=//p' >"$state/group-tag"
    ;;
  'group show'*)
    [[ -f $state/group ]] || { echo 'ERROR: (ResourceGroupNotFound)' >&2 && exit 3; }
    cat "$state/group-tag" 2>/dev/null || echo
    ;;
  'group delete'*) rm -f "$state/group" "$state/group-tag" ;;
  'deployment group what-if'*) echo 'Resource and property changes are indicated with this symbol: + Create (24 resources)' ;;
  'deployment group create'*) deployment_create ;;
  'deployment group show'*) deployment_outputs ;;
  'monitor log-analytics workspace show'*) echo 7d0a5f1e-0000-4000-8000-0000000000a1 ;;
  'monitor log-analytics query'*) log_query ;;
  'keyvault secret show'*)
    # Every item exists; generated passwords read back as a valid value.
    if [[ $(option --query) == value ]]; then printf '%064d\n' 0; fi
    ;;
  'keyvault secret set'*)
    [[ $(option --name) != braid-owner-input ]] || cp -- "$(option --file)" "$state/owner-input"
    ;;
  'keyvault certificate show'* | 'keyvault certificate create'*) ;;
  'keyvault certificate download'*) certificate_download ;;
  'keyvault show'*) echo 'https://braid-kv-fake.vault.azure.net/' ;;
  'identity show'*) echo "/subscriptions/$FAKE_SUBSCRIPTION/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/braid-identity" ;;
  'acr build'*) echo 'Run ID: ca1 was successful after 2m' ;;
  'acr repository show'*) printf 'sha256:%s\n' "$(printf '%s' "$(option --image)" | sha256sum | cut -d' ' -f1)" ;;
  'acr login'*) echo 'Login Succeeded' ;;
  'containerapp job start'*) job_start ;;
  'containerapp job execution show'*)
    execution=$(option --job-execution-name)
    # The first poll of each execution still reports it running.
    if [[ -f $state/executions/$execution.polled ]]; then cat "$state/executions/$execution.status"; else
      touch "$state/executions/$execution.polled" && echo Running
    fi
    ;;
  'containerapp job show'*)
    jq -n '{containers: [{name: "database-roles", image: "docker.io/library/postgres@sha256:ec9f656f17c8b4dfebf49e58cf5c46d493d4846d4ea6d8b85d0637f68ee33bfc",
      command: ["bash", "-c", "provision"], resources: {cpu: 0.5, memory: "1Gi"},
      env: [{name: "PGHOST", value: "braid-pg-fake"}, {name: "BRAID_MIGRATOR_PASSWORD", secretRef: "pg-migrator-password"}]}]}'
    ;;
  'containerapp job secret set'*) ;;
  'containerapp job list'*)
    jq -n '[{name: "braid-migrate", properties: {template: {containers: [{image: "braidacrfake.azurecr.io/braid:tag"}]}}},
      {name: "braid-database-roles", properties: {template: {containers: [{image: "docker.io/library/postgres@sha256:ec9f"}]}}},
      {name: "braid-session-keys", properties: {template: {volumes: [{name: "session-keys", storageType: "AzureFile"}],
        containers: [{image: "braidacrfake.azurecr.io/braid:tag", volumeMounts: [{volumeName: "session-keys", mountPath: "/var/lib/braid/keys"}]}]}}}]'
    ;;
  'containerapp list'*)
    jq -n '[{name: "braid-app", properties: {template: {volumes: [{name: "session-keys", storageType: "AzureFile"}],
        containers: [{image: "braidacrfake.azurecr.io/braid:tag", volumeMounts: [{volumeName: "session-keys", mountPath: "/var/lib/braid/keys"}]},
          {image: "braidacrfake.azurecr.io/braid-edge:tag"}]}}},
      {name: "braid-ferrule", properties: {template: {volumes: [{name: "operations", storageType: "EmptyDir"}],
        containers: [{image: "braidacrfake.azurecr.io/braid-ferrule-service@sha256:00", volumeMounts: [{volumeName: "operations", mountPath: "/tmp"}]}]}}}]'
    ;;
  'containerapp revision list'*) echo "$(option --name)--rev1" ;;
  'containerapp revision restart'*) ;;
  'containerapp revision show'*)
    if [[ $(option --revision) == *--broken-* ]]; then
      echo '{"health": "Unhealthy", "running": "Failed"}'
    else
      echo '{"active": true, "traffic": 100, "health": "Healthy"}'
    fi
    ;;
  'containerapp update'*)
    if has --set-env-vars; then
      echo 'ERROR: The revision failed to provision.' >&2
      exit 1
    fi
    option --min-replicas >"$state/replicas-$(option --name)"
    ;;
  'containerapp show'*) containerapp_show ;;
  'containerapp replica list'*) cat "$state/replicas-$(option --name)" 2>/dev/null || echo 1 ;;
  'ad app show'*)
    jq -n --arg uri "https://$public_host/api/auth/callback/entra" \
      --arg key "$(openssl x509 -in "$FAKE_CERTIFICATE_PEM" -outform DER | openssl dgst -sha1 -binary | base64 -w0)" \
      '{uris: [$uri], keys: [$key]}'
    ;;
  'rest --method post'*) database_query ;;
  *) echo "Unexpected fake Azure CLI call: $*" >&2 && exit 2 ;;
esac
