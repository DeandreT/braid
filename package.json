{
  "name": "braid",
  "description": "braid — understand, test, and deploy your data mappings.",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:browser-session-probe": "bun run --cwd apps/web build:browser-session-probe",
    "check": "bun run format:check && bun run check:dependency-security && bun run check:mfd-interchange && bun run check:browser-fixture && bun run check:docs-images && bun run contracts:check && bun run --cwd apps/web check:chat-types && bun run --cwd apps/web check && bun run --cwd apps/web check:browser && bun run check:browser-session-probe",
    "check:tooling": "python3 -m unittest discover -s tools/ci -p 'test_*.py' && python3 -m unittest discover -s tools/browser-fixture -p 'test_launch.py' && python3 -m unittest discover -s tools/build-worker -p 'test_*.py'",
    "test": "python3 tools/ci/run_tests.py --group fast",
    "check:dependency-security": "bun test ./tools/dependency-security.test.mjs",
    "test:dependency-security-browser": "bun run --cwd apps/web test:e2e --config playwright.dependency-security.config.ts",
    "check:mfd-interchange": "bun test ./tools/mfd-interchange-tests.mjs",
    "check:browser-fixture": "bun test --isolate --timeout 60000 ./tools/browser-fixture/security-headers.test.mjs ./tools/browser-fixture/editor-dev-server.test.mjs ./tools/browser-fixture/dev-editor-policy.test.mjs ./tools/browser-fixture/csv-document.test.mjs ./tools/browser-fixture/xml-document.test.mjs ./tools/browser-fixture/preview-unsent.test.mjs ./tools/browser-fixture/sandbox-owner.test.mjs ./tools/browser-fixture/edi-segments.test.mjs ./tools/browser-fixture/schema.test.mjs ./tools/browser-fixture/failure-site.test.mjs ./tools/browser-fixture/safe-diagnostics.test.mjs ./tools/browser-fixture/test-subnets.test.mjs ./tools/hosted-acceptance/model.test.mjs ./tools/hosted-acceptance/endpoint-settlement.test.mjs ./tools/hosted-acceptance/acceptance-lifecycle.test.mjs ./tools/hosted-acceptance/test-subnets.test.mjs ./tools/hosted-acceptance/public-client.test.mjs",
    "check:browser-session-probe": "bun run --cwd apps/web check:browser-session-probe",
    "check:docs-images": "bun test ./tools/docs-images/check.test.mjs && bun tools/docs-images/check.mjs",
    "contracts:generate": "bun run --cwd tools/contracts-generator generate",
    "contracts:check": "bun run --cwd tools/contracts-generator check && bun tools/contracts-generator/check-specifications.mjs && bun run --cwd apps/web check:contracts",
    "format": "prettier --write \"apps/web/**/*.{ts,html,css,json}\" \"tools/**/*.{mjs,json}\" package.json global.json",
    "test:browser": "python3 tools/browser-fixture/launch.py --",
    "test:spec-intake-browser": "bun run --cwd apps/web test:e2e --config playwright.spec-intake.config.ts",
    "test:browser-session": "python3 tools/browser-fixture/launch.py -- --config playwright.browser-session.config.ts",
    "test:auth-https-stage-diagnostics": "bun test ./tools/auth-browser-stage-diagnostics.test.mjs",
    "test:auth-https-source": "bun run test:auth-https-stage-diagnostics && bun run --cwd apps/web test:e2e --config playwright.auth-https-source.config.ts",
    "test:auth-https-browser": "python3 tools/browser-fixture/launch.py --no-core-dumps --display-from-env -- --config playwright.auth-https.config.ts",
    "test:sandbox-browser": "bun run --cwd apps/web test:e2e --config playwright.sandbox.config.ts",
    "test:catalog-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.catalog.config.ts",
    "test:reports-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.reports.config.ts",
    "test:mapping-viewer-browser": "python3 tools/browser-fixture/launch.py -- --config tests/mapping-viewer.config.ts",
    "test:project-creation-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.project-creation.config.ts",
    "test:mapping-metadata-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.mapping-metadata.config.ts",
    "test:native-mapping-upload-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.native-mapping-upload.config.ts",
    "test:native-revision-append-browser": "python3 tools/browser-fixture/launch.py -- --config playwright.native-revision-append.config.ts",
    "format:check": "prettier --check \"apps/web/**/*.{ts,html,css,json}\" \"tools/**/*.{mjs,json}\" package.json global.json"
  },
  "overrides": {
    "vite": "8.3.4"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
