{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "weft": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "weft",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/style.css"],
            "outputPath": "dist/weft",
            "deployUrl": "/",
            "assets": [{ "glob": "**/*", "input": "public", "output": "/" }]
          },
          "configurations": {
            "production": {
              "deployUrl": "/",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": { "inline": false }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "750kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true },
            "devServer": {
              "optimization": false,
              "sourceMap": true,
              "index": "index.dev.html"
            }
          },
          "defaultConfiguration": "production"
        },
        "browser-session-probe": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/browser-session/probe-main.ts",
            "index": {
              "input": "tests/browser-session/probe-index.html",
              "output": "index.html"
            },
            "tsConfig": "tsconfig.browser-session-probe.json",
            "styles": ["src/style.css"],
            "baseHref": "/__weft119_probe/",
            "outputPath": {
              "base": "dist/browser-session-probe",
              "browser": "browser"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1250kB",
                  "maximumError": "1500kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "defaultConfiguration": "development",
          "configurations": {
            "development": { "buildTarget": "weft:build:devServer" }
          }
        }
      }
    }
  }
}
