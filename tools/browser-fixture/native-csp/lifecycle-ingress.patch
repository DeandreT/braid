+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_CSP_FIXTURE_LIFECYCLE_INGRESS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_CSP_FIXTURE_LIFECYCLE_INGRESS_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <string_view>
+
+namespace braid::probe {
+
+// Main sequence and one original DocumentToken only. This monitors a subset
+// of DOM listener ingress. It is neither an app policy nor a browser cutoff.
+class LifecycleIngress {
+ public:
+  enum class Failure {
+    kNone,
+    kWrongOriginal,
+    kUnknownRegistration,
+    kUnsupportedPublication,
+    kLatePublication,
+    kPendingAtPrepare,
+    kLostAtClear,
+    kWindowReuse,
+    kCapacity,
+    kInvalidTransition,
+  };
+  enum class Provenance { kTrustedDom, kSynthetic };
+  using Id = uint64_t;
+  struct Ticket {
+    std::string original;
+    Id revision;
+  };
+
+  LifecycleIngress() = default;
+  LifecycleIngress(const LifecycleIngress&) = delete;
+  LifecycleIngress& operator=(const LifecycleIngress&) = delete;
+
+  bool BindOriginal(std::string_view original) {
+    if (!original_.empty() || original.empty() || detached_) {
+      Refuse(Failure::kWrongOriginal);
+      return false;
+    }
+    original_ = original;
+    return failure_ == Failure::kNone;
+  }
+
+  void Register(const void* registration) {
+    if (prepared_ || detached_) {
+      return Refuse(Failure::kLatePublication);
+    }
+    if (original_.empty() || !registration || Contains(registration)) {
+      return Refuse(Failure::kUnknownRegistration);
+    }
+    for (auto& slot : registrations_) {
+      if (!slot) {
+        slot = registration;
+        Advance();
+        return;
+      }
+    }
+    Refuse(Failure::kCapacity);
+  }
+
+  void Remove(const void* registration) {
+    for (auto& slot : registrations_) {
+      if (slot && slot == registration) {
+        slot = nullptr;
+        Advance();
+        return;
+      }
+    }
+    Refuse(Failure::kUnknownRegistration);
+  }
+
+  // Blink's bulk clear is not the application's natural listener removal.
+  // A possibly live registration must not disappear from the inventory.
+  void BulkClear(const void* registration) {
+    if (Contains(registration)) {
+      Refuse(Failure::kLostAtClear);
+    } else {
+      Refuse(Failure::kUnknownRegistration);
+    }
+  }
+
+  // Acquire before 'once' removes the registration and before invoking script.
+  Id Enter(const void* registration, Provenance provenance) {
+    if (prepared_ || detached_) {
+      Refuse(Failure::kLatePublication);
+      return 0;
+    }
+    if (!Contains(registration)) {
+      Refuse(Failure::kUnknownRegistration);
+      return 0;
+    }
+    if (depth_ >= callbacks_.size() || !Advance()) {
+      Refuse(Failure::kCapacity);
+      return 0;
+    }
+    callbacks_[depth_++] = {revision_, false};
+    if (provenance == Provenance::kTrustedDom) {
+      ++trusted_calls_;
+    } else {
+      ++synthetic_calls_;
+    }
+    return revision_;
+  }
+
+  void Leave(Id callback) {
+    if (!callback) {
+      return;
+    }
+    if (!depth_ || CurrentCallback() != callback) {
+      return Refuse(Failure::kInvalidTransition);
+    }
+    if (!callbacks_[depth_ - 1].covered) {
+      Refuse(Failure::kUnsupportedPublication);
+    }
+    --depth_;
+    Advance();
+  }
+
+  Id CurrentCallback() const { return depth_ ? callbacks_[depth_ - 1].id : 0; }
+
+  // Native producer owner only: after installing the original callback
+  // handoffs, attest that its synchronous body ran under that coverage.
+  // Live descendants remain independent. Callback return alone is not proof.
+  void AcknowledgeCoverage(std::string_view original, Id callback) {
+    if (!CheckOriginal(original)) {
+      return;
+    }
+    if (!callback || callback != CurrentCallback() ||
+        callbacks_[depth_ - 1].covered) {
+      return Refuse(Failure::kInvalidTransition);
+    }
+    callbacks_[depth_ - 1].covered = true;
+  }
+
+  // Called by the existing producer ledger *before* publishing a child. The
+  // child's identity remains live across return and may publish descendants.
+  // Publication with no original link is not evidence for this boundary.
+  Id Publish(std::string_view original, Id parent) {
+    if (!CheckOriginal(original)) {
+      return 0;
+    }
+    if (prepared_ || detached_) {
+      Refuse(Failure::kLatePublication);
+      return 0;
+    }
+    if (!parent || (parent != CurrentCallback() && !HasChild(parent))) {
+      Refuse(Failure::kUnsupportedPublication);
+      return 0;
+    }
+    for (auto& child : children_) {
+      if (!child && Advance()) {
+        return child = revision_;
+      }
+    }
+    Refuse(Failure::kCapacity);
+    return 0;
+  }
+
+  void Complete(std::string_view original, Id id) {
+    if (!CheckOriginal(original)) {
+      return;
+    }
+    for (auto& child : children_) {
+      if (child && child == id) {
+        child = 0;
+        Advance();
+        return;
+      }
+    }
+    Refuse(Failure::kUnsupportedPublication);
+  }
+
+  // Observation while waiting for ordinary app destruction is not prepare.
+  bool Ready() const {
+    if (original_.empty() || failure_ != Failure::kNone || detached_ ||
+        depth_) {
+      return false;
+    }
+    for (const auto* registration : registrations_) {
+      if (registration) {
+        return false;
+      }
+    }
+    for (Id child : children_) {
+      if (child) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // Production callers must also fence/prepare every other producer class.
+  // A failed preparation is sticky; late work is still delivered by Blink.
+  Ticket Prepare(std::string_view original) {
+    if (!CheckOriginal(original)) {
+      return {};
+    }
+    if (prepared_) {
+      Refuse(Failure::kInvalidTransition);
+      return {};
+    }
+    prepared_ = true;
+    if (!Ready() || !Advance()) {
+      Refuse(Failure::kPendingAtPrepare);
+      return {};
+    }
+    prepared_revision_ = revision_;
+    return {original_, prepared_revision_};
+  }
+
+  void Detach(std::string_view original) {
+    if (!CheckOriginal(original)) {
+      return;
+    }
+    if (detached_ || !prepared_revision_ || !Ready() ||
+        revision_ != prepared_revision_) {
+      Refuse(Failure::kInvalidTransition);
+    }
+    detached_ = true;
+  }
+
+  bool VerifyRetirement(const Ticket& ticket) const {
+    return prepared_revision_ && detached_ && failure_ == Failure::kNone &&
+           ticket.original == original_ &&
+           ticket.revision == prepared_revision_;
+  }
+
+  void Refuse(Failure reason) {
+    if (failure_ == Failure::kNone) {
+      failure_ = reason;
+    }
+  }
+
+  Failure failure() const { return failure_; }
+  Id trusted_calls() const { return trusted_calls_; }
+  Id synthetic_calls() const { return synthetic_calls_; }
+
+ private:
+  bool CheckOriginal(std::string_view original) {
+    if (!original_.empty() && original_ == original) {
+      return true;
+    }
+    Refuse(Failure::kWrongOriginal);
+    return false;
+  }
+
+  bool Advance() {
+    if (revision_ == std::numeric_limits<Id>::max()) {
+      Refuse(Failure::kCapacity);
+      return false;
+    }
+    ++revision_;
+    return true;
+  }
+
+  bool Contains(const void* registration) const {
+    if (registration) {
+      for (const auto* slot : registrations_) {
+        if (slot == registration) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  bool HasChild(Id id) const {
+    for (Id child : children_) {
+      if (child && child == id) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  std::string original_;
+  std::array<const void*, 128> registrations_{};
+  struct Callback {
+    Id id;
+    bool covered;
+  };
+  std::array<Callback, 32> callbacks_{};
+  std::array<Id, 256> children_{};
+  std::size_t depth_ = 0;
+  Id revision_ = 0;
+  Id prepared_revision_ = 0;
+  Id trusted_calls_ = 0;
+  Id synthetic_calls_ = 0;
+  Failure failure_ = Failure::kNone;
+  bool prepared_ = false;
+  bool detached_ = false;
+};
+
+}  // namespace braid::probe
