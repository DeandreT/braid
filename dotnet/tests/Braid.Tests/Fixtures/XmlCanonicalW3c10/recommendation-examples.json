    },
    {
      "section": "3.7",
      "url": "https://www.w3.org/TR/2001/REC-xml-c14n-20010315#Example-DocSubsets",
      "title": "Document Subsets",
      "disposition": "refuse",
      "constraints": [
        "dtd",
        "document-subset"
      ],
      "input": {
        "sourceCodeHtml": "\n&lt;!DOCTYPE doc [ <br/>\n&lt;!ATTLIST e2 xml:space (default|preserve) 'preserve'> <br/>\n&lt;!ATTLIST e3 id ID #IMPLIED> <br/>\n]> <br/>\n&lt;doc xmlns=\"http://www.ietf.org\" xmlns:w3c=\"http://www.w3.org\"> <br/>\n&nbsp;&nbsp;&nbsp;&lt;e1> <br/>\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;e2 xmlns=\"\"> <br/>\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;e3 id=\"E3\"/> <br/>\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;/e2> <br/>\n&nbsp;&nbsp;&nbsp;&lt;/e1> <br/>\n&lt;/doc>\n",
        "sourceCodeSha256": "1369abb3d76298610583a65b86251d6f8220305291f55707188a2bca5d73967a",
        "base64": "",
        "sha256": "67664e9ec3832cf1bf50fbfb589717e4fc949e2628563bb4dfdac7ba95b03463"
      },
      "subsetExpression": {
        "sourceCodeHtml": "\n&lt;!-- Evaluate with declaration xmlns:ietf=\"http://www.ietf.org\" --&gt; <br/>\n<br/>\n(//. | //@* | //namespace::*) <br/>\n[ <br/>\n&nbsp;&nbsp;&nbsp;self::ietf:e1 or (parent::ietf:e1 and not(self::text() or self::e2)) <br/>\n&nbsp;&nbsp;&nbsp;or <br/>\n&nbsp;&nbsp;&nbsp;count(id(\"E3\")|ancestor-or-self::node()) = count(ancestor-or-self::node()) <br/>\n]",
        "sourceCodeSha256": "17ae3f899d1c9e8163bcbe1a9318100476c76581ceddd277a4a45ed2da3ce94f",
