+protocol::Response InspectorAuditsAgent::armBraidDispatch(const String& epoch, String* generation) {
+  auto* frame = inspected_frames_->Root();
+  auto* doc = frame ? frame->GetDocument() : nullptr;
+  if (braid_refused_ || braid_scope_ || epoch.length() != 32 || !doc || !frame->IsMainFrame() ||
+      !doc->domWindow() || doc->Url().GetString() != "http://braid.invalid/fixture") {
+    braid_refused_ = true;
+    return protocol::Response::ServerError("fixture refused");
+  }
+  // ExecutionContext constructs exactly one ExecutionContextCSPDelegate.
+  auto& delegate = static_cast<ExecutionContextCSPDelegate&>(doc->domWindow()->GetContentSecurityPolicyDelegate());
+  if (delegate.HasFixtureProbe()) {
+    braid_refused_ = true;
+    return protocol::Response::ServerError("already enrolled");
+  }
+  braid_epoch_ = epoch;
+  braid_document_ = doc;
+  braid_scope_ = std::make_shared<braid::probe::Scope>();
+  braid_dispatch_ = std::make_shared<String>();
+  delegate.SetFixtureProbe(braid_scope_, base::BindRepeating([](std::shared_ptr<String> id, const Event& e) {
+    const auto& v = static_cast<const SecurityPolicyViolationEvent&>(e);
+    if (!id->empty() || !e.isTrusted() || e.eventPhase() != Event::PhaseType::kCapturingPhase ||
+        v.effectiveDirective() != "worker-src" || v.violatedDirective() != "worker-src" ||
+        v.blockedURI() != "http://braid.invalid/owned-worker.js" ||
+        v.disposition().AsEnum() != V8SecurityPolicyViolationEventDisposition::Enum::kEnforce)
+      return false;
+    *id = String::FromUtf8(base::UnguessableToken::Create().ToString());
+    return true;
+  }, braid_dispatch_));
+  *generation = String::FromUtf8(doc->Token().ToString());
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorAuditsAgent::readBraidDispatch(const String& epoch, String* generation, String* dispatch) {
+  auto* frame = inspected_frames_->Root();
+  auto* doc = braid_document_.Get();
+  if (braid_refused_ || !braid_scope_ || braid_epoch_ != epoch || !doc || !frame ||
+      frame->GetDocument() != doc || !doc->domWindow() || doc->domWindow()->IsContextDestroyed()) {
+    braid_refused_ = true;
+    return protocol::Response::ServerError("original fixture lost");
+  }
+  // Terminal read of this one enrolled delegate, not a fence on its producers.
+  braid_scope_->SealIngress();
+  if (braid_dispatch_->empty() || braid_scope_->Inspect() != braid::probe::Scope::Status::ClosedLocalOnly) {
+    braid_refused_ = true;
+    return protocol::Response::ServerError("dispatch not settled");
+  }
+  *generation = String::FromUtf8(doc->Token().ToString());
+  *dispatch = *braid_dispatch_;
+  return protocol::Response::Success();
+}
