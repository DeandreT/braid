    {
      "section": "3.4",
      "url": "https://www.w3.org/TR/2001/REC-xml-c14n-20010315#Example-Chars",
      "title": "Character Modifications and Character References",
      "disposition": "refuse",
      "constraints": [
        "dtd"
      ],
      "input": {
        "sourceCodeHtml": "\n&lt;!DOCTYPE doc [<br/>\n&lt;!ATTLIST normId id ID #IMPLIED><br/>\n&lt;!ATTLIST normNames attr NMTOKENS #IMPLIED><br/>\n]><br/>\n&lt;doc><br/>\n&nbsp;&nbsp;&nbsp;&lt;text>First line&amp;#x0d;&amp;#10;Second line&lt;/text><br/>\n&nbsp;&nbsp;&nbsp;&lt;value>&amp;#x32;&lt;/value><br/>\n&nbsp;&nbsp;&nbsp;&lt;compute>&lt;![CDATA[value>\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"]]&gt;&lt;/compute><br/>\n&nbsp;&nbsp;&nbsp;&lt;compute expr='value>\"0\" &amp;amp;&amp;amp; value&amp;lt;\"10\" ?\"valid\":\"error\"'>valid&lt;/compute><br/>\n&nbsp;&nbsp;&nbsp;&lt;norm attr=' &amp;apos;&nbsp;&nbsp;&nbsp;&amp;#x20;&amp;#13;&amp;#xa;&amp;#9;&nbsp;&nbsp;&nbsp;&amp;apos; '/><br/>\n&nbsp;&nbsp;&nbsp;&lt;normNames attr='&nbsp;&nbsp;&nbsp;A&nbsp;&nbsp;&nbsp;&amp;#x20;&amp;#13;&amp;#xa;&amp;#9;&nbsp;&nbsp;&nbsp;B&nbsp;&nbsp;&nbsp;'/><br/>\n&nbsp;&nbsp;&nbsp;&lt;normId id=' &amp;apos;&nbsp;&nbsp;&nbsp;&amp;#x20;&amp;#13;&amp;#xa;&amp;#9;&nbsp;&nbsp;&nbsp;&amp;apos; '/><br/>\n&lt;/doc><br/>\n",
        "sourceCodeSha256": "f0fb74654b87530496925e1609df1924b788f73b4333c85d528b6bb5d0989176",
        "base64": "",
        "sha256": "74386ae086569be3c144127c4e3c513c18c3154ba78c822f18b4495d9c9493e0"
      }
    },
    {
      "section": "3.5",
      "url": "https://www.w3.org/TR/2001/REC-xml-c14n-20010315#Example-Entities",
      "title": "Entity References",
      "disposition": "refuse",
      "constraints": [
        "dtd",
        "external-entity"
      ],
      "input": {
        "sourceCodeHtml": "\n&lt;!DOCTYPE doc [<br/>\n&lt;!ATTLIST doc attrExtEnt ENTITY #IMPLIED><br/>\n&lt;!ENTITY ent1 \"Hello\"><br/>\n&lt;!ENTITY ent2 SYSTEM \"world.txt\"><br/>\n&lt;!ENTITY entExt SYSTEM \"earth.gif\" NDATA gif><br/>\n&lt;!NOTATION gif SYSTEM \"viewgif.exe\"><br/>\n]><br/>\n&lt;doc attrExtEnt=\"entExt\"><br/>\n&nbsp;&nbsp;&nbsp;&amp;ent1;, &amp;ent2;!<br/>\n&lt;/doc><br/>\n<br/>\n&lt;!-- Let world.txt contain \"world\" (excluding the quotes) -->\n",
        "sourceCodeSha256": "0ccb502d81587f189549f21bab663776ceb727bb73f921d9dd450dc361a0e913",
        "base64": "",
        "sha256": "4c9ff345a2a3355005e047b874c26abede4402fe782335288e982900bf368372"
      }
    },
    {
      "section": "3.6",
      "url": "https://www.w3.org/TR/2001/REC-xml-c14n-20010315#Example-UTF8",
      "title": "UTF-8 Encoding",
      "disposition": "refuse",
      "constraints": [
        "non-utf8-declaration"
