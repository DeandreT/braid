+TEST_F(ContentSecurityPolicyTest, FixtureLocalCaptureIsNotBrowserCutoff) {
+  using Status = braid::probe::Scope::Status;
+  auto page = std::make_unique<DummyPageHolder>();
+  auto& window = *page->GetFrame().DomWindow();
+  auto* delegate = MakeGarbageCollected<ExecutionContextCSPDelegate>(window);
+  auto local = std::make_shared<braid::probe::Scope>();
+  delegate->SetFixtureProbe(local, base::BindRepeating([](const Event& e) {
+    // Only the delegate arms the exact native CSP event on this stack.
+    auto& event = static_cast<const SecurityPolicyViolationEvent&>(e);
+    return event.isTrusted() && event.effectiveDirective() == "worker-src" &&
+           event.violatedDirective() == "worker-src" && event.blockedURI() == "https://example.test/owned-worker.js" &&
+           event.disposition().AsEnum() == V8SecurityPolicyViolationEventDisposition::Enum::kEnforce;
+  }));
+  page->GetDocument().SetURL(secure_url);
+  window.GetSecurityContext().SetSecurityOriginForTesting(secure_origin);
+  csp->BindToDelegate(*delegate);
+  csp->AddPolicies(ParseContentSecurityPolicies("worker-src 'none'", ContentSecurityPolicyType::kEnforce,
+                                                 ContentSecurityPolicySource::kHTTP, *secure_origin));
+  const KURL blocked("https://example.test/owned-worker.js");
+  EXPECT_FALSE(csp->AllowWorkerContextFromSource(blocked));
+  local->SealIngress(); EXPECT_EQ(Status::Pending, local->Inspect());
+  base::RunLoop().RunUntilIdle(); EXPECT_EQ(Status::ClosedLocalOnly, local->Inspect());
+  EXPECT_FALSE(csp->AllowWorkerContextFromSource(blocked));
+  base::RunLoop().RunUntilIdle(); EXPECT_EQ(Status::Failed, local->Inspect());
+  auto mismatch = std::make_shared<braid::probe::Scope>();
+  delegate->SetFixtureProbe(mismatch, base::BindRepeating([](const Event&) { return false; }));
+  EXPECT_FALSE(csp->AllowWorkerContextFromSource(blocked));
+  mismatch->SealIngress();
+  base::RunLoop().RunUntilIdle(); EXPECT_EQ(Status::Failed, mismatch->Inspect());
+}
