{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "packageManager": "bun" },
  "projects": {
    "braid": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "braid",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/style.css"],
            "outputPath": "dist/braid",
            "deployUrl": "/",
            "assets": [{ "glob": "**/*", "input": "public", "output": "/" }]
          },
          "configurations": {
            "production": {
              "deployUrl": "/",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": { "inline": false }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "750kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true },
            "devServer": {
              "optimization": false,
              "sourceMap": true,
              "index": "index.dev.html",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "output": "/",
                  "ignore": ["edit/**"]
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "browser-session-probe": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/browser-session/probe-main.ts",
            "index": {
              "input": "tests/browser-session/probe-index.html",
              "output": "index.html"
            },
            "tsConfig": "tsconfig.browser-session-probe.json",
            "styles": ["src/style.css"],
            "deployUrl": "/__braid119_probe/",
            "outputPath": {
              "base": "dist/browser-session-probe",
              "browser": "browser"
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1250kB",
                  "maximumError": "1500kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "./tools/dev-server:dev-server",
          "options": {
            "hmr": false,
            "liveReload": false,
            "headers": {
              "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; child-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
              "X-Content-Type-Options": "nosniff",
              "Referrer-Policy": "no-referrer",
              "Cross-Origin-Opener-Policy": "same-origin",
              "Cross-Origin-Resource-Policy": "same-origin"
            }
          },
          "defaultConfiguration": "development",
          "configurations": {
            "development": { "buildTarget": "braid:build:devServer" }
          }
        }
      }
    }
  }
}
