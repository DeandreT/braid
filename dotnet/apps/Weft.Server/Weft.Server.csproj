<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Angular assets are copied into the packaged host, not served from SDK source manifests. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OpenApiDocumentsDirectory>../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name weft-v1 --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" PrivateAssets="all" />
    <ProjectReference Include="../../src/Weft.Api/Weft.Api.csproj" />
    <ProjectReference Include="../../src/Weft.Application/Weft.Application.csproj" />
    <ProjectReference Include="../../src/Weft.MappingBackends/Weft.MappingBackends.csproj" />
    <ProjectReference Include="../../src/Weft.Persistence.Postgres/Weft.Persistence.Postgres.csproj" />
    <ProjectReference Include="../../src/Weft.Storage.FileSystem/Weft.Storage.FileSystem.csproj" />
    <Content Include="../../../apps/web/dist/weft/browser/**/*"
             Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
