+// Qualification-only native API. No web API or browser-wide status.
+#include "third_party/blink/renderer/core/workers/csp_fixture_workers.h"
+
+#include <mutex>
+#include <utility>
+
+#include "base/no_destructor.h"
+
+namespace blink {
+namespace {
+
+using Ledger = braid::probe::WorkerCspLedger;
+
+struct ProcessSlot {
+  std::mutex lock;
+  bool used = false;
+  std::shared_ptr<Ledger> ledger;
+  WorkerCspCheck check;
+};
+
+ProcessSlot& GetProcessSlot() {
+  static base::NoDestructor<ProcessSlot> slot;
+  return *slot;
+}
+
+}  // namespace
+
+std::shared_ptr<Ledger> InstallWorkerCspFixture(WorkerCspCheck check) {
+  auto& slot = GetProcessSlot();
+  std::lock_guard guard(slot.lock);
+  if (slot.used || !check) {
+    slot.used = true;
+    if (slot.ledger) {
+      slot.ledger->Refuse(Ledger::Refusal::kInvalidTransition);
+    }
+    return nullptr;
+  }
+  slot.used = true;
+  slot.check = std::move(check);
+  slot.ledger = std::make_shared<Ledger>();
+  return slot.ledger;
+}
+
+std::unique_ptr<FixtureWorkerCspProducer>
+ReserveFixtureClassicDedicatedWorker() {
+  auto& slot = GetProcessSlot();
+  std::lock_guard guard(slot.lock);
+  slot.used = true;
+  if (!slot.ledger) {
+    return nullptr;
+  }
+  auto generation = slot.ledger->Reserve();
+  if (!generation) {
+    return nullptr;
+  }
+  return std::make_unique<FixtureWorkerCspProducer>(
+      FixtureWorkerCspProducer{std::move(generation), slot.check});
+}
+
+void RefuseFixtureWorker(Ledger::Refusal reason) {
+  auto& slot = GetProcessSlot();
+  std::lock_guard guard(slot.lock);
+  slot.used = true;
+  if (slot.ledger) {
+    slot.ledger->Refuse(reason);
+  }
+}
+
+}  // namespace blink
